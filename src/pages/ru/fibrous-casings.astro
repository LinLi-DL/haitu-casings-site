---
import SiteLayout from '../../layouts/SiteLayout.astro';

const products = [
  {
    id: 'natural-color',
    title: 'Фиброузные оболочки натурального цвета',
    label: 'НАТУРАЛЬНЫЙ ЦВЕТ',
    image: '/images/fibrous-casings-clear.jpg',
    text: 'Фиброузные оболочки натурального цвета. Свяжитесь с нами, чтобы уточнить доступные калибры, характеристики и варианты поставки.',
    href: '/ru/fibrous-casings/natural-color/',
  },
  {
    id: 'colored',
    title: 'Цветные Фиброузные оболочки',
    label: 'ЦВЕТНЫЕ ОБОЛОЧКИ',
    image: '/images/fibrous-casings-colored.jpg',
    text: 'Цветные Фиброузные оболочки для колбасных изделий, требующих определённого цвета оболочки. Доступные цвета и характеристики уточняются по запросу.',
    href: '/ru/fibrous-casings/colored/',
  },
  {
    id: 'printed',
    title: 'Печатные Фиброузные оболочки',
    label: 'ОБОЛОЧКИ С ПЕЧАТЬЮ',
    image: '/images/fibrous-casings-printed.jpg',
    text: 'Фиброузные оболочки с печатью для производителей колбасных изделий, которым требуется индивидуальное оформление продукции. Свяжитесь с нами, чтобы обсудить доступные варианты печати.',
    href: '/ru/fibrous-casings/printed/',
  },
  {
    id: 'large-caliber',
    title: 'Фиброузные оболочки большого калибра',
    label: 'БОЛЬШОЙ КАЛИБР',
    image: '/images/fibrous-casings-large.jpg',
    text: 'Фиброузные оболочки большого калибра для соответствующих видов колбасных и мясных изделий. Уточните у нас требуемый калибр и область применения.',
    href: '/ru/fibrous-casings/large-caliber/',
  },
];
---

<SiteLayout
  lang="ru"
  title="Фиброузные оболочки | Haitu Casing"
  description="Фиброузные оболочки Haitu: натурального цвета, цветные, с печатью и большого калибра для производства колбасных изделий."
>
  <section class="page-intro catalog-page-intro">
    <p class="eyebrow">Haitu Casing</p>
    <h1>Фиброузные оболочки</h1>
  </section>

  <section class="content-section plastic-catalog">
    <nav class="category-nav" aria-label="Категории продукции">
      <a class="category-link" href="/ru/plastic-casings/">
        <span>Пластиковые оболочки</span>
        <span class="category-arrow" aria-hidden="true">↗</span>
      </a>

      <a class="category-link" href="/ru/collagen-casings/">
        <span>Коллагеновые оболочки</span>
        <span class="category-arrow" aria-hidden="true">↗</span>
      </a>

      <a class="category-link" href="/ru/cellulose-casings/">
        <span>Целлюлозные оболочки</span>
        <span class="category-arrow" aria-hidden="true">↗</span>
      </a>

      <a
        class="category-link is-current"
        href="/ru/fibrous-casings/"
        aria-current="page"
      >
        <span>Фиброузные оболочки</span>
        <span class="category-arrow" aria-hidden="true">↗</span>
      </a>

      <a
        class="category-link"
        href="/ru/food-processing-equipment/"
      >
        <span>Оборудование для переработки</span>
        <span class="category-arrow" aria-hidden="true">↗</span>
      </a>
    </nav>

    <div class="catalog-grid">
      {products.map((product) => (
        <article class="catalog-card" id={product.id}>
          <a class="product-image-link" href={product.href}>
            <img
              src={product.image}
              alt={product.title}
              loading="lazy"
            />
          </a>

          <div class="catalog-card-copy">
            <p class="eyebrow">{product.label}</p>
            <h2>
              <a href={product.href}>{product.title}</a>
            </h2>
            <p>{product.text}</p>
            <a class="text-link" href={product.href}>
              Подробнее о продукте →
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</SiteLayout>

<style>
  .plastic-catalog {
    max-width: none;
  }

  .catalog-page-intro {
    background-image:
      linear-gradient(
        90deg,
        rgb(255 250 246 / 92%) 0%,
        rgb(255 250 246 / 75%) 45%,
        rgb(255 250 246 / 15%) 100%
      ),
      url('/images/hero-fibrous-casings.jpg');

    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;

    padding: 56px clamp(22px, 13.15vw, 176px);
    border-radius: 10px;
  }

  .category-nav {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
    margin: -18px 0 98px;
    padding: 0;
  }

  .category-link {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    min-height: 30px;
    padding: 9px 12px;
    border: 1px solid #eadbd2;
    border-bottom: 3px solid #eadbd2;
    border-radius: 7px;
    background: #fffaf6;
    color: #1d3c59;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.35;
    text-decoration: none;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .category-number {
    flex: 0 0 auto;
    color: #c66a4e;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .category-arrow {
    flex: 0 0 auto;
    margin-left: auto;
    color: #c66a4e;
    font-size: 15px;
    transition: transform 0.2s ease;
  }

  .category-link:hover {
    border-color: #cf4438;
    border-bottom-color: #cf4438;
    background: #fff0e8;
    color: #a92f28;
    transform: translateY(-2px);
  }

  .category-link:hover .category-arrow {
    transform: translate(2px, -2px);
  }

  /* Текущая категория: сплошной тёплый красный цвет */
  .category-nav .category-link.is-current,
  .category-nav .category-link.is-current:hover {
    border-color: #c93632;
    border-bottom-color: #a92327;
    background: #c93632;
    color: #fff;
    box-shadow: 0 4px 12px rgb(201 54 50 / 18%);
    transform: none;
  }

  .category-nav .category-link.is-current .category-number,
  .category-nav .category-link.is-current .category-arrow {
    color: #fff;
  }

  @media (max-width: 1050px) {
    .category-nav {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .category-nav {
      display: flex;
      gap: 10px;
      margin-bottom: 26px;
      padding: 3px 2px 12px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .category-link {
      flex: 0 0 auto;
      min-height: 56px;
      padding: 11px 13px;
      white-space: nowrap;
    }
  }
</style>
