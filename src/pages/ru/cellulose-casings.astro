
---
import SiteLayout from '../../layouts/SiteLayout.astro';

const products = [
  {
    id: 'clear',
    title: 'Прозрачные целлюлозные оболочки',
    label: 'ПРОЗРАЧНЫЕ ЦЕЛЛЮЛОЗНЫЕ ОБОЛОЧКИ',
    image: '/images/cellulose-casings-clear.jpg',
    text: 'Прозрачный внешний вид · Традиционные целлюлозные оболочки · Для производства колбасных изделий',
    href: '/ru/cellulose-casings/clear/',
  },
  {
    id: 'color',
    title: 'Цветные целлюлозные оболочки',
    label: 'ЦВЕТНЫЕ ЦЕЛЛЮЛОЗНЫЕ ОБОЛОЧКИ',
    image: '/images/cellulose-casings-colored.jpg',
    text: 'Различные цветовые решения · Выразительный внешний вид колбасных изделий · Цвета по запросу',
    href: '/ru/cellulose-casings/color/',
  },
  {
    id: 'stripes',
    title: 'Целлюлозные оболочки с полосками',
    label: 'ЦЕЛЛЮЛОЗНЫЕ ОБОЛОЧКИ С ПОЛОСКАМИ',
    image: '/images/cellulose-casings-stripes.jpg',
    text: 'Полосатый рисунок · Декоративное оформление колбасных изделий · Варианты дизайна по запросу',
    href: '/ru/cellulose-casings/stripes/',
  },
  {
    id: 'transfer-color',
    title: 'Целлюлозные оболочки с эффектом переноса цвета',
    label: 'ЦЕЛЛЮЛОЗНЫЕ ОБОЛОЧКИ С ПЕРЕНОСОМ ЦВЕТА',
    image: '/images/cellulose-casings-transfer.jpg',
    text: 'Эффект переноса цвета · Особый внешний вид поверхности · Варианты исполнения по запросу',
    href: '/ru/cellulose-casings/transfer-color/',
  },
];
---

<SiteLayout
  lang="ru"
  title="Целлюлозные оболочки | Haitu Casing"
  description="Целлюлозные оболочки Haitu: прозрачные, цветные, с полосками и эффектом переноса цвета для производства колбасных изделий."
>
  <section class="page-intro catalog-page-intro">
    <p class="eyebrow">Haitu Casing</p>
    <h1>Целлюлозные оболочки</h1>
  </section>

  <section class="content-section plastic-catalog">
    <nav class="category-nav" aria-label="Категории продукции">
      <a class="category-link" href="/ru/plastic-casings/">
        <span>Пластиковые оболочки</span>
        <span class="category-arrow" aria-hidden="true">↗</span>
      </a>

      <a class="category-link" href="/ru/collagen-casings/">
        <span>Коллагеновые оболочки</span>
        <span class="category-arrow" aria-hidden="true">↗</span>
      </a>

      <a
        class="category-link is-current"
        href="/ru/cellulose-casings/"
        aria-current="page"
      >
        <span>Целлюлозные оболочки</span>
        <span class="category-arrow" aria-hidden="true">↗</span>
      </a>

      <a class="category-link" href="/ru/fibrous-casings/">
        <span>Фиброузные оболочки</span>
        <span class="category-arrow" aria-hidden="true">↗</span>
      </a>

      <a
        class="category-link"
        href="/ru/food-processing-equipment/"
      >
        <span>Оборудование для переработки</span>
        <span class="category-arrow" aria-hidden="true">↗</span>
      </a>
    </nav>

    <div class="catalog-grid">
      {products.map((product) => (
        <article class="catalog-card" id={product.id}>
          <a class="product-image-link" href={product.href}>
            <img
              src={product.image}
              alt={product.title}
              loading="lazy"
            />
          </a>

          <div class="catalog-card-copy">
            <p class="eyebrow">{product.label}</p>
            <h2>
              <a href={product.href}>{product.title}</a>
            </h2>
            <p>{product.text}</p>
            <a class="text-link" href={product.href}>
              Подробнее о продукте →
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</SiteLayout>

<style>
  .plastic-catalog {
    max-width: none;
  }

.catalog-page-intro {
  background-image:
    linear-gradient(
      90deg,
      rgb(255 250 246 / 92%) 0%,
      rgb(255 250 246 / 75%) 45%,
      rgb(255 250 246 / 15%) 100%
    ),
    url('/images/hero-cellulose-casings.jpg');

  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;

  padding: 56px clamp(22px, 13.15vw, 176px);
  border-radius: 10px;
}

  .category-nav {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
    margin: -18px 0 98px;
    padding: 0;
  }

  .category-link {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    min-height: 30px;
    padding: 9px 12px;
    border: 1px solid #eadbd2;
    border-bottom: 3px solid #eadbd2;
    border-radius: 7px;
    background: #fffaf6;
    color: #1d3c59;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.35;
    text-decoration: none;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .category-number {
    flex: 0 0 auto;
    color: #c66a4e;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .category-arrow {
    flex: 0 0 auto;
    margin-left: auto;
    color: #c66a4e;
    font-size: 15px;
    transition: transform 0.2s ease;
  }

  .category-link:hover {
    border-color: #cf4438;
    border-bottom-color: #cf4438;
    background: #fff0e8;
    color: #a92f28;
    transform: translateY(-2px);
  }

  .category-link:hover .category-arrow {
    transform: translate(2px, -2px);
  }

  /* Текущая категория: сплошной оранжево-красный цвет */
  .category-nav .category-link.is-current,
  .category-nav .category-link.is-current:hover {
    border-color: #c93632;
    border-bottom-color: #a92327;
    background: #c93632;
    color: #fff;
    box-shadow: 0 4px 12px rgb(201 54 50 / 18%);
    transform: none;
  }

  .category-nav .category-link.is-current .category-number,
  .category-nav .category-link.is-current .category-arrow {
    color: #fff;
  }

  @media (max-width: 1050px) {
    .category-nav {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .category-nav {
      display: flex;
      gap: 10px;
      margin-bottom: 26px;
      padding: 3px 2px 12px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .category-link {
      flex: 0 0 auto;
      min-height: 56px;
      padding: 11px 13px;
      white-space: nowrap;
    }
  }
</style>

