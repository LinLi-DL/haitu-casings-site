
---

import SiteLayout from '../../../layouts/SiteLayout.astro';

const product = {
  title: 'Легкоочищаемая оболочка HT для колбас малого калибра',
  subtitle: '',
  image: '/images/ht-peel.jpg',
};
---

<SiteLayout
  lang="ru"
  title="Легкоочищаемая пластиковая оболочка HT для колбас малого калибра | Haitu Casing"
  description="Трёхслойная высокобарьерная пластиковая оболочка для колбас малого калибра, разработанная для лёгкого снятия после термической обработки."
>
  <section class="page-intro product-page-intro">
    <p class="eyebrow">
      <a href="/ru/plastic-casings/">Пластиковые оболочки</a>
    </p>
    <h1>{product.title}</h1>
    <p class="product-subtitle">{product.subtitle}</p>
  </section>

  <section class="content-section product-overview">
    <div class="product-image">
      <img src={product.image} alt="Легкоочищаемая пластиковая оболочка HT для колбас малого калибра" />
    </div>
    <div class="product-info">
      <h2>Описание продукта</h2>
      <p>
        Легкоочищаемая пластиковая оболочка HT — это трёхслойная
        соэкструзионная высокобарьерная полимерная оболочка,
        предназначенная для производства колбасных изделий малого калибра.
        Её свойства облегчают снятие оболочки после обработки с помощью
        автоматизированного оборудования.
      </p>
      <h2>Область применения</h2>
      <p>
        Колбасные изделия малого калибра, включая сосиски и мини-сосиски,
        особенно продукция, для которой предусмотрено автоматическое
        или полуавтоматическое снятие оболочки.
      </p>
      <h2>Основные характеристики</h2>
      <ul>
        <li>Трёхслойная высокобарьерная структура помогает сохранять качество продукции во время хранения.</li>
        <li>Специальные свойства поверхности облегчают снятие оболочки после обработки.</li>
        <li>Подходит для производства колбасных изделий малого калибра.</li>
        <li>Хорошая механическая прочность для шприцевания и последующих технологических операций.</li>
        <li>Поставляется преимущественно в виде гофрированных палочек для использования на производственных линиях.</li>
      </ul>
    </div>
  </section>

  <section class="content-section specifications">
    <h2>Технические характеристики</h2>
    <div class="spec-table-wrap">
      <table class="spec-table">
        <tbody>
          <tr><th>Калибр</th><td>16 – 25 мм</td></tr>
          <tr><th>Тип</th><td>Трёхслойная высокобарьерная, легкоочищаемая</td></tr>
          <tr><th>Цвета</th><td>Прозрачная и цветные варианты</td></tr>
          <tr><th>Печать</th><td>Доступна</td></tr>
          <tr><th>Форма поставки</th><td>Гофрированные палочки (основная форма поставки) или рулоны</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="cta product-cta">
    <div>
      <h2>Нужны технические характеристики или коммерческое предложение?</h2>
      <p>Сообщите нам тип колбасного изделия, требуемый калибр, цвет, параметры печати и предпочтительную форму поставки.</p>
    </div>
    <a class="button button-red" href="/ru/contact-us/">Связаться с Haitu Casing →</a>
  </section>
</SiteLayout>

<style>
  .product-intro .eyebrow a { color: var(--red); }
  .product-intro .product-subtitle { margin-top: 8px; }
  .product-overview {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 36px;
    align-items: start;
    max-width: 1280px;
  }
  .product-image img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }
  .product-info h2,
  .specifications h2 {
    margin: 0 0 12px;
    color: var(--navy);
    font-size: clamp(21px, 2vw, 27px);
  }
  .product-info h2:not(:first-child) { margin-top: 24px; }
  .product-info p,
  .product-info ul,
  .product-cta p { color: var(--muted); line-height: 1.75; }
  .product-info ul { padding-left: 20px; margin-bottom: 0; }
  .product-info li + li { margin-top: 6px; }
  .specifications { max-width: 900px; padding-top: 12px; }
  .spec-table-wrap { overflow-x: auto; }
  .spec-table { width: 100%; border-collapse: collapse; border: 1px solid var(--line); }
  .spec-table th, .spec-table td {
    padding: 12px 16px; border-bottom: 1px solid var(--line);
    text-align: left; vertical-align: top;
  }
  .spec-table th {
    width: 32%; color: var(--navy); background: #f8f8f6; font-weight: 600;
  }
  .spec-table td { color: var(--muted); }
  .spec-table tr:last-child th, .spec-table tr:last-child td { border-bottom: 0; }
  .product-cta { margin-top: 28px; }
  @media (max-width: 720px) {
    .product-overview { grid-template-columns: 1fr; gap: 24px; }
    .product-image img { max-height: 480px; object-fit: contain; }
    .spec-table th, .spec-table td { padding: 10px 12px; }
  }
</style>


