---
import SiteLayout from '../../../layouts/SiteLayout.astro';

const product = {
  title: 'Фиброузные оболочки большого калибра',
  subtitle: '',
  image: '/images/fibrous-casings-large.jpg',
};
---

<SiteLayout
  lang="ru"
  title="Фиброузные оболочки большого калибра | Haitu Casing"
  description="Фиброузные оболочки большого калибра для крупноформатных колбасных изделий и соответствующих мясоперерабатывающих производств."
>
  <section class="page-intro product-page-intro">
    <p class="eyebrow">
      <a href="/ru/fibrous-casings/">Фиброузные оболочки</a>
    </p>
    <h1>{product.title}</h1>
  </section>

  <section class="content-section product-overview">
    <div class="product-image">
      <img
        src={product.image}
        alt="Фиброузные оболочки большого калибра"
      />
    </div>

    <div class="product-info">
      <h2>Описание продукта</h2>
      <p>
        Фиброузные оболочки большого калибра предназначены для
        производства колбасных изделий и мясных продуктов, требующих
        оболочки увеличенного диаметра. Подходящий вариант выбирается
        с учётом типа готовой продукции, способа технологической
        обработки и требуемых размеров готового изделия.
      </p>

      <h2>Применение</h2>
      <p>
        Используются для крупноформатных колбасных изделий и других
        мясных продуктов, для производства которых подходят
        фиброузные оболочки. При запросе цены необходимо уточнить
        назначение продукции и условия её обработки.
      </p>

      <h2>Основные особенности</h2>
      <ul>
        <li>Варианты большого калибра для соответствующих видов колбасной продукции.</li>
        <li>Доступные спецификации зависят от требований к готовому изделию.</li>
        <li>
          Калибр, печать, цвет и форма поставки согласовываются
          в соответствии с подтверждёнными требованиями заказчика.
        </li>
      </ul>
    </div>
  </section>

  <section class="content-section specifications">
    <h2>Характеристики</h2>

    <div class="spec-table-wrap">
      <table class="spec-table">
        <tbody>
          <tr>
            <th>Тип</th>
            <td>Фиброузная оболочка</td>
          </tr>
          <tr>
            <th>Калибр</th>
            <td>Варианты большого калибра уточняются</td>
          </tr>
          <tr>
            <th>Цвета</th>
            <td>Доступные варианты уточняются</td>
          </tr>
          <tr>
            <th>Печать</th>
            <td>Уточняется в соответствии с требованиями к продукции</td>
          </tr>
          <tr>
            <th>Форма поставки</th>
            <td>Уточняется</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="cta product-cta">
    <div>
      <h2>Нужны характеристики или коммерческое предложение?</h2>
      <p>
        Сообщите нам требуемый калибр, вид колбасной продукции,
        способ технологической обработки и предполагаемые
        требования к поставке.
      </p>
    </div>
    <a class="button button-red" href="/ru/contact-us/">
      Связаться с Haitu Casing →
    </a>
  </section>
</SiteLayout>

<style>
  .product-intro .eyebrow a {
    color: var(--red);
  }

  .product-intro .product-subtitle {
    margin-top: 8px;
  }

  .product-overview {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 36px;
    align-items: start;
    max-width: 1280px;
  }

  .product-image img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .product-info h2,
  .specifications h2 {
    margin: 0 0 12px;
    color: var(--navy);
    font-size: clamp(21px, 2vw, 27px);
  }

  .product-info h2:not(:first-child) {
    margin-top: 24px;
  }

  .product-info p,
  .product-info ul,
  .product-cta p {
    color: var(--muted);
    line-height: 1.75;
  }

  .product-info ul {
    padding-left: 20px;
    margin-bottom: 0;
  }

  .product-info li + li {
    margin-top: 6px;
  }

  .specifications {
    max-width: 900px;
    padding-top: 12px;
  }

  .spec-table-wrap {
    overflow-x: auto;
  }

  .spec-table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--line);
  }

  .spec-table th,
  .spec-table td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .spec-table th {
    width: 32%;
    color: var(--navy);
    background: #f8f8f6;
    font-weight: 600;
  }

  .spec-table td {
    color: var(--muted);
  }

  .spec-table tr:last-child th,
  .spec-table tr:last-child td {
    border-bottom: 0;
  }

  .product-cta {
    margin-top: 28px;
  }

  @media (max-width: 720px) {
    .product-overview {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .product-image img {
      max-height: 480px;
      object-fit: contain;
    }

    .spec-table th,
    .spec-table td {
      padding: 10px 12px;
    }
  }
</style>