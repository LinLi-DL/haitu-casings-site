---
import SiteLayout from '../../layouts/SiteLayout.astro';
const products = [
  { title: 'Пластиковые оболочки', image: '/images/plastic-casings-preview.jpg', text: 'Варианты цветов, печати и размеров для различных задач.', href: '/ru/plastikovye-obolochki/' },
  { title: 'Коллагеновые оболочки', image: '/images/collagen-casings-preview.jpg', text: 'Узнайте о доступных вариантах коллагеновых оболочек.', href: '/ru/kollagenovye-obolochki/' },
  { title: 'Целлюлозные оболочки', image: '/images/cellulose-casings-preview.jpg', text: 'Уточните доступные спецификации и условия поставки.', href: '/ru/tsellyuloznye-obolochki/' },
];
---
<SiteLayout lang="ru" title="Haitu Casing | Оболочки для колбасных изделий" description="Пластиковые, коллагеновые и целлюлозные оболочки для производителей колбас и дистрибьюторов.">
  <section class="hero"><div class="hero-copy"><p class="eyebrow">Поставки оболочек для B2B</p><h1>Оболочки для вашего колбасного производства</h1><p>Пластиковые, коллагеновые и целлюлозные оболочки для производителей колбасных изделий и дистрибьюторов.</p><div class="hero-buttons"><a class="button button-red" href="#products">Наши продукты →</a><a class="button button-outline" href="/ru/kontakty/">Запросить цену</a></div><div class="trust-row"><span><b>✓</b> Уточнение спецификаций</span><span><b>◎</b> Международные B2B-поставки</span><span><b>↗</b> Долгосрочное сотрудничество</span></div></div><img class="hero-image" src="/images/hero-products-preview.jpg" alt="Ассортимент оболочек для колбасных изделий" /></section>
  <section class="section" id="products"><div class="section-heading"><div><p class="eyebrow">Наша продукция</p><h2>Категории продукции</h2></div><a class="text-link" href="/ru/plastikovye-obolochki/">Все продукты →</a></div><div class="product-grid">{products.map((p) => <article class="product-card"><a href={p.href}><img src={p.image} alt={p.title} loading="lazy" /></a><div class="product-card-copy"><h3><a href={p.href}>{p.title}</a></h3><p>{p.text}</p><a class="text-link" href={p.href}>Подробнее →</a></div></article>)}</div></section>
  <section class="feature-band"><div class="feature"><span class="feature-icon">◇</span><div><strong>Понятные спецификации</strong><p>Согласование характеристик до заказа.</p></div></div><div class="feature"><span class="feature-icon">◎</span><div><strong>Международная связь</strong><p>Общение с B2B-клиентами.</p></div></div><div class="feature"><span class="feature-icon">↔</span><div><strong>Гибкое сотрудничество</strong><p>Обсудим ваши задачи и поставки.</p></div></div><div class="feature"><span class="feature-icon">✉</span><div><strong>Поддержка клиентов</strong><p>Свяжитесь с нами за информацией.</p></div></div></section>
  <section class="cta"><div><h2>Подберём оболочку под ваши задачи?</h2><p>Сообщите тип продукта, калибр и требования к упаковке.</p></div><a class="button button-red" href="/ru/kontakty/">Связаться с Haitu Casing →</a></section>
</SiteLayout>
