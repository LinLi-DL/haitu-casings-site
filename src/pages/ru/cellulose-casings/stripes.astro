
---
import SiteLayout from '../../../layouts/SiteLayout.astro';

const product = {
  title: 'Целлюлозные оболочки с полосками',
  subtitle: '',
  image: '/images/cellulose-casings-stripes.jpg',
};
---

<SiteLayout
  lang="ru"
  title="Целлюлозные оболочки с полосками | Haitu Casing"
  description="Целлюлозные оболочки с цветными полосками для колбасных изделий, где требуется визуальная идентификация оболочки и контроль её снятия."
>
  <section class="page-intro product-page-intro">
    <p class="eyebrow">
      <a href="/ru/cellulose-casings/">Целлюлозные оболочки</a>
    </p>
    <h1>{product.title}</h1>
  </section>

  <section class="content-section product-overview">
    <div class="product-image">
      <img
        src={product.image}
        alt="Целлюлозные оболочки с полосками"
      />
    </div>

    <div class="product-info">
      <h2>Описание продукта</h2>
      <p>
        Целлюлозные оболочки с полосками имеют хорошо заметную
        маркировку, которая помогает идентифицировать оболочку
        в процессе производства колбасных изделий и при её снятии.
        Они могут использоваться в тех случаях, когда визуальный
        контроль удаления оболочки является важной частью
        производственного процесса.
      </p>

      <h2>Область применения</h2>
      <p>
        Подходят для производства колбасных изделий, где полоски
        помогают распознавать оболочку и визуально контролировать
        её снятие с готовой продукции.
      </p>

      <h2>Основные характеристики</h2>
      <ul>
        <li>Заметная маркировка: облегчает визуальное распознавание оболочки в процессе производства.</li>
        <li>Помощь при снятии оболочки: полоски позволяют оператору визуально оценить, полностью ли удалена оболочка.</li>
        <li>Выбор цвета: цвет полосок может быть согласован в соответствии с доступными вариантами исполнения.</li>
        <li>Идентификация продукции: маркировка может использоваться для визуального различения типов оболочек или партий продукции, если это предусмотрено технологией.</li>
      </ul>
    </div>
  </section>

  <section class="content-section specifications">
    <h2>Технические характеристики</h2>

    <div class="spec-table-wrap">
      <table class="spec-table">
        <tbody>
          <tr>
            <th>Тип</th>
            <td>Целлюлозная оболочка</td>
          </tr>
          <tr>
            <th>Внешний вид</th>
            <td>С полосками</td>
          </tr>
          <tr>
            <th>Калибр</th>
            <td>По запросу</td>
          </tr>
          <tr>
            <th>Дизайн полосок</th>
            <td>Доступные варианты уточняются по запросу</td>
          </tr>
          <tr>
            <th>Форма поставки</th>
            <td>В гофрированных палочках</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="cta product-cta">
    <div>
      <h2>Нужны технические характеристики или расчёт стоимости?</h2>
      <p>
        Сообщите нам тип колбасных изделий, желаемый дизайн полосок,
        требуемый калибр и особенности технологического процесса.
      </p>
    </div>
    <a class="button button-red" href="/ru/contact-us/">
      Связаться с Haitu Casing →
    </a>
  </section>
</SiteLayout>

<style>
  .product-intro .eyebrow a {
    color: var(--red);
  }

  .product-intro .product-subtitle {
    margin-top: 8px;
  }

  .product-overview {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 36px;
    align-items: start;
    max-width: 1280px;
  }

  .product-image img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .product-info h2,
  .specifications h2 {
    margin: 0 0 12px;
    color: var(--navy);
    font-size: clamp(21px, 2vw, 27px);
  }

  .product-info h2:not(:first-child) {
    margin-top: 24px;
  }

  .product-info p,
  .product-info ul,
  .product-cta p {
    color: var(--muted);
    line-height: 1.75;
  }

  .product-info ul {
    padding-left: 20px;
    margin-bottom: 0;
  }

  .product-info li + li {
    margin-top: 6px;
  }

  .specifications {
    max-width: 900px;
    padding-top: 12px;
  }

  .spec-table-wrap {
    overflow-x: auto;
  }

  .spec-table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--line);
  }

  .spec-table th,
  .spec-table td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .spec-table th {
    width: 32%;
    color: var(--navy);
    background: #f8f8f6;
    font-weight: 600;
  }

  .spec-table td {
    color: var(--muted);
  }

  .spec-table tr:last-child th,
  .spec-table tr:last-child td {
    border-bottom: 0;
  }

  .product-cta {
    margin-top: 28px;
  }

  @media (max-width: 720px) {
    .product-overview {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .product-image img {
      max-height: 480px;
      object-fit: contain;
    }

    .spec-table th,
    .spec-table td {
      padding: 10px 12px;
    }
  }
</style>
