---
import SiteLayout from '../../../layouts/SiteLayout.astro';

const product = {
  title: 'Коллагеновые оболочки для жареных колбасок',
  subtitle: '',
  image: '/images/collagen-casings-fried.jpg',
};
---

<SiteLayout
  lang="ru"
  title="Коллагеновые оболочки для жареных колбасок | Haitu Casing"
  description="Коллагеновые оболочки для колбасных изделий, предназначенных для жарки при высоких температурах и длительной термической обработки."
>
  <section class="page-intro product-page-intro">
  <p class="eyebrow">
    <a href="/ru/collagen-casings/">Коллагеновые оболочки</a>
  </p>
  <h1>{product.title}</h1>
</section>

<section class="content-section product-overview">
  <div class="product-image">
    <img src={product.image} alt="Коллагеновые оболочки для жареных колбасок" />
  </div>

  <div class="product-info">
    <h2>Описание продукта</h2>
    <p>
      Коллагеновые оболочки для жареных колбасок разработаны
      для производства колбасных изделий, требующих жарки
      при высоких температурах или длительной термической обработки.
    </p>

    <h2>Область применения</h2>
    <p>
      Хот-доги, сосиски, колбаски для жарки во фритюре
      и различные виды колбасных изделий для быстрого питания.
    </p>

    <h2>Основные характеристики</h2>
    <ul>
      <li>Устойчивость к длительной жарке во фритюре при высоких температурах.</li>
      <li>Подходят также для длительного приготовления на гриле.</li>
      <li>Устойчивы к разрывам при обработке паром, варке в воде и повторной стерилизации.</li>
      <li>Рекомендуемые способы обработки: жарка во фритюре, приготовление на гриле, варка в воде, обработка паром и приготовление в аэрогриле.</li>
    </ul>
  </div>
</section>

<section class="content-section specifications">
  <h2>Технические характеристики</h2>

  <div class="spec-table-wrap">
    <table class="spec-table">
      <tbody>
        <tr>
          <th>Тип</th>
          <td>Коллагеновая оболочка для жареных колбасок</td>
        </tr>
        <tr>
          <th>Калибр</th>
          <td>13 – 34 мм</td>
        </tr>
        <tr>
          <th>Цвет</th>
          <td>Прозрачная</td>
        </tr>
        <tr>
          <th>Форма поставки</th>
          <td>В гофрированных палочках</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<section class="cta product-cta">
  <div>
    <h2>Нужны технические характеристики или расчёт стоимости?</h2>
    <p>
      Сообщите нам тип колбасных изделий, требуемый калибр,
      способ жарки и требования к поставке.
    </p>
  </div>
  <a class="button button-red" href="/ru/contact-us/">
    Связаться с Haitu Casing →
  </a>
</section>
</SiteLayout>

<style>
  .product-intro .eyebrow a {
    color: var(--red);
  }

  .product-intro .product-subtitle {
    margin-top: 8px;
  }

  .product-overview {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 36px;
    align-items: start;
    max-width: 1280px;
  }

  .product-image img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .product-info h2,
  .specifications h2 {
    margin: 0 0 12px;
    color: var(--navy);
    font-size: clamp(21px, 2vw, 27px);
  }

  .product-info h2:not(:first-child) {
    margin-top: 24px;
  }

  .product-info p,
  .product-info ul,
  .product-cta p {
    color: var(--muted);
    line-height: 1.75;
  }

  .product-info ul {
    padding-left: 20px;
    margin-bottom: 0;
  }

  .product-info li + li {
    margin-top: 6px;
  }

  .specifications {
    max-width: 900px;
    padding-top: 12px;
  }

  .spec-table-wrap {
    overflow-x: auto;
  }

  .spec-table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--line);
  }

  .spec-table th,
  .spec-table td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .spec-table th {
    width: 32%;
    color: var(--navy);
    background: #f8f8f6;
    font-weight: 600;
  }

  .spec-table td {
    color: var(--muted);
  }

  .spec-table tr:last-child th,
  .spec-table tr:last-child td {
    border-bottom: 0;
  }

  .product-cta {
    margin-top: 28px;
  }

  @media (max-width: 720px) {
    .product-overview {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .product-image img {
      max-height: 480px;
      object-fit: contain;
    }

    .spec-table th,
    .spec-table td {
      padding: 10px 12px;
    }
  }
</style>