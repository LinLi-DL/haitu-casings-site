
---
import SiteLayout from '../../layouts/SiteLayout.astro';

const products = [
  {
    id: 'standard-cooking',
    title: 'Стандартные коллагеновые оболочки для варёных колбас',
    label: 'СТАНДАРТНЫЕ ОБОЛОЧКИ ДЛЯ ВАРЁНЫХ КОЛБАС',
    image: '/images/collagen-casings-standard-cooking.jpg',
    text: 'Для варёных колбас · Универсальное применение · Различные калибры',
    href: '/ru/collagen-casings/standard-cooking/',
  },
  {
    id: 'premium-tender-cooking',
    title: 'Премиальные коллагеновые оболочки с нежной текстурой',
    label: 'ПРЕМИАЛЬНЫЕ ОБОЛОЧКИ ДЛЯ ВАРЁНЫХ КОЛБАС',
    image: '/images/collagen-casings-exported-cooking.jpg',
    text: 'Нежная текстура при укусе · Для варёных колбас · Калибры по запросу',
    href: '/ru/collagen-casings/premium-tender-cooking/',
  },
  {
    id: 'frying',
    title: 'Коллагеновые оболочки для жареных колбас',
    label: 'ОБОЛОЧКИ ДЛЯ ЖАРЕНЫХ КОЛБАС',
    image: '/images/collagen-casings-fried.jpg',
    text: 'Для колбасных изделий, предназначенных для жарки · Варианты исполнения по запросу',
    href: '/ru/collagen-casings/frying/',
  },
  {
    id: 'dry-sausage',
    title: 'Коллагеновые оболочки для сыровяленых колбас',
    label: 'ОБОЛОЧКИ ДЛЯ СЫРОВЯЛЕНЫХ КОЛБАС',
    image: '/images/collagen-casings-dry.jpg',
    text: 'Для производства сыровяленых колбас · Подходят для процессов сушки · Калибры по запросу',
    href: '/ru/collagen-casings/dry-sausage/',
  },
  {
    id: 'colored',
    title: 'Цветные коллагеновые оболочки',
    label: 'ЦВЕТНЫЕ КОЛЛАГЕНОВЫЕ ОБОЛОЧКИ',
    image: '/images/collagen-casings-colored.jpg',
    text: 'Различные цветовые решения · Для разных видов колбасных изделий · Доступные цвета по запросу',
    href: '/ru/collagen-casings/colored/',
  },
];
---

<SiteLayout
  lang="ru"
  title="Коллагеновые оболочки | Haitu Casing"
  description="Коллагеновые оболочки Haitu для варёных, жареных, сыровяленых колбас, а также цветные варианты для различных видов колбасных изделий."
>
  <section class="page-intro catalog-page-intro">
    <p class="eyebrow">Haitu Casing</p>
    <h1>Коллагеновые оболочки</h1>
  </section>

  <section class="content-section product-catalog">
    <nav class="category-nav" aria-label="Категории продукции">
      <a class="category-link" href="/ru/plastic-casings/">
        <span>Пластиковые оболочки</span>
        <span class="category-arrow" aria-hidden="true">↗</span>
      </a>

      <a
        class="category-link is-current"
        href="/ru/collagen-casings/"
        aria-current="page"
      >
        <span>Коллагеновые оболочки</span>
        <span class="category-arrow" aria-hidden="true">↗</span>
      </a>

      <a class="category-link" href="/ru/cellulose-casings/">
        <span>Целлюлозные оболочки</span>
        <span class="category-arrow" aria-hidden="true">↗</span>
      </a>

      <a class="category-link" href="/ru/fibrous-casings/">
        <span>Фиброузные оболочки</span>
        <span class="category-arrow" aria-hidden="true">↗</span>
      </a>

      <a
        class="category-link"
        href="/ru/food-processing-equipment/"
      >
        <span>Оборудование для переработки</span>
        <span class="category-arrow" aria-hidden="true">↗</span>
      </a>
    </nav>

    <div class="catalog-grid">
      {products.map((product) => (
        <article class="catalog-card" id={product.id}>
          <a class="product-image-link" href={product.href}>
            <img
              src={product.image}
              alt={product.title}
              loading="lazy"
            />
          </a>

          <div class="catalog-card-copy">
            <p class="eyebrow">{product.label}</p>
            <h2>
              <a href={product.href}>{product.title}</a>
            </h2>
            <p>{product.text}</p>
            <a class="text-link" href={product.href}>
              Запросить информацию о продукте →
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</SiteLayout>

<style>
  .product-catalog {
    max-width: none;
  }

  .catalog-page-intro {
    background-image:
      linear-gradient(
        90deg,
        rgb(255 250 246 / 92%) 0%,
        rgb(255 250 246 / 75%) 45%,
        rgb(255 250 246 / 15%) 100%
      ),
      url('/images/ht-collagen-casings.jpg');

    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;

    padding: 56px clamp(22px, 13.15vw, 176px);
    border-radius: 10px;
  }

  .category-nav {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
    margin: -18px 0 98px;
    padding: 0;
  }

  .category-link {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    min-height: 30px;
    padding: 9px 12px;
    border: 1px solid #eadbd2;
    border-bottom: 3px solid #eadbd2;
    border-radius: 7px;
    background: #fffaf6;
    color: #1d3c59;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.35;
    text-decoration: none;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .category-number {
    flex: 0 0 auto;
    color: #c66a4e;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .category-arrow {
    flex: 0 0 auto;
    margin-left: auto;
    color: #c66a4e;
    font-size: 15px;
    transition: transform 0.2s ease;
  }

  .category-link:hover {
    border-color: #cf4438;
    border-bottom-color: #cf4438;
    background: #fff0e8;
    color: #a92f28;
    transform: translateY(-2px);
  }

  .category-link:hover .category-arrow {
    transform: translate(2px, -2px);
  }

  .category-nav .category-link.is-current,
  .category-nav .category-link.is-current:hover {
    border-color: #c93632;
    border-bottom-color: #a92327;
    background: #c93632;
    color: #fff;
    box-shadow: 0 4px 12px rgb(201 54 50 / 18%);
    transform: none;
  }

  .category-nav .category-link.is-current .category-number,
  .category-nav .category-link.is-current .category-arrow {
    color: #fff;
  }

  .catalog-card-copy h2 a {
    color: inherit;
    text-decoration: none;
  }

  .catalog-card-copy h2 a:hover {
    color: #b8322d;
  }

  .text-link {
    display: inline-block;
    margin-top: 4px;
  }

  @media (max-width: 1050px) {
    .category-nav {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .category-nav {
      display: flex;
      gap: 10px;
      margin-bottom: 26px;
      padding: 3px 2px 12px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .category-link {
      flex: 0 0 auto;
      min-height: 56px;
      padding: 11px 13px;
      white-space: nowrap;
    }
  }
</style>

