
---
import SiteLayout from '../../../layouts/SiteLayout.astro';

const product = {
  title:  'Color Cellulose Casings',
  subtitle: '',
  image: '/images/cellulose-casings-colored.jpg',
};
---

<SiteLayout
  lang="en"
  title="Color Cellulose Casings | Haitu Casing"
  description="Color cellulose casings for sausage manufacturers seeking different casing colors and distinctive product presentation."
>
  <section class="page-intro product-page-intro">
    <p class="eyebrow">
      <a href="/en/cellulose-casings/">Cellulose Casings</a>
    </p>
    <h1>{product.title}</h1>
  </section>

  <section class="content-section product-overview">
    <div class="product-image">
      <img
        src={product.image}
        alt="Color Cellulose Casings"
      />
    </div>

    <div class="product-info">
      <h2>Product Description</h2>
      <p>
        Color Cellulose Casing is developed for sausage manufacturers who require colored casings for product differentiation and visual identification. Available color options can be selected according to the intended product appearance and processing requirements.
      </p>

      <h2>Application</h2>
      <p>
        Suitable for sausage products requiring colored casings for visual differentiation and product presentation.
      </p>

      <h2>Key Features</h2>
      <ul>
        <li>Color Options: Different colors can be offered according to confirmed product availability.</li>
        <li>Product Differentiation: Helps distinguish sausage varieties through their external appearance.</li>
        <li>Cellulose-Based Material: Designed for compatible sausage manufacturing processes.</li>
        <li>•	Application Flexibility: Color selection can be matched to specific product requirements.</li>
      </ul>
    </div>
  </section>

  <section class="content-section specifications">
    <h2>Specifications</h2>

    <div class="spec-table-wrap">
      <table class="spec-table">
        <tbody>
          <tr>
            <th>Type</th>
            <td>Cellulose casing</td>
          </tr>
          <tr>
            <th>Appearance</th>
            <td>Colored</td>
          </tr>
          <tr>
            <th>Caliber</th>
            <td>Available upon request</td>
          </tr>
          <tr>
            <th>Colors</th>
            <td>Available options to be confirmed</td>
          </tr>
          <tr>
            <th>Supply form</th>
            <td>Shirred</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="cta product-cta">
    <div>
      <h2>Need specifications or a quotation?</h2>
      <p>
        Tell us your sausage type, preferred color, target caliber
        and processing requirements.
      </p>
    </div>
    <a class="button button-red" href="/en/contact-us/">
      Contact Haitu Casing →
    </a>
  </section>
</SiteLayout>

<style>
  .product-intro .eyebrow a {
    color: var(--red);
  }

  .product-intro .product-subtitle {
    margin-top: 8px;
  }

  .product-overview {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 36px;
    align-items: start;
    max-width: 1280px;
  }

  .product-image img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .product-info h2,
  .specifications h2 {
    margin: 0 0 12px;
    color: var(--navy);
    font-size: clamp(21px, 2vw, 27px);
  }

  .product-info h2:not(:first-child) {
    margin-top: 24px;
  }

  .product-info p,
  .product-info ul,
  .product-cta p {
    color: var(--muted);
    line-height: 1.75;
  }

  .product-info ul {
    padding-left: 20px;
    margin-bottom: 0;
  }

  .product-info li + li {
    margin-top: 6px;
  }

  .specifications {
    max-width: 900px;
    padding-top: 12px;
  }

  .spec-table-wrap {
    overflow-x: auto;
  }

  .spec-table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--line);
  }

  .spec-table th,
  .spec-table td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .spec-table th {
    width: 32%;
    color: var(--navy);
    background: #f8f8f6;
    font-weight: 600;
  }

  .spec-table td {
    color: var(--muted);
  }

  .spec-table tr:last-child th,
  .spec-table tr:last-child td {
    border-bottom: 0;
  }

  .product-cta {
    margin-top: 28px;
  }

  @media (max-width: 720px) {
    .product-overview {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .product-image img {
      max-height: 480px;
      object-fit: contain;
    }

    .spec-table th,
    .spec-table td {
      padding: 10px 12px;
    }
  }
</style>
