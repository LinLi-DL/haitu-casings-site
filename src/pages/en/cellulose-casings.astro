
---
import SiteLayout from '../../layouts/SiteLayout.astro';

const products = [
  {
    id: 'transparent',
    title: 'Transparent Cellulose Casings',
    label: 'TRANSPARENT CELLULOSE',
    image: '/images/cellulose-casings-clear.jpg',
    text: 'Transparent Appearance · Traditional Cellulose Casing · Suitable for Sausage Processing',
    href: '/en/cellulose-casings/transparent/',
  },
  {
    id: 'colored',
    title: 'Colored Cellulose Casings',
    label: 'COLORED CELLULOSE',
    image: '/images/cellulose-casings-colored.jpg',
    text: 'Colored Appearance · Distinctive Sausage Presentation · Color Options Available on Request',
    href: '/en/cellulose-casings/colored/',
  },
  {
    id: 'striped',
    title: 'Striped Cellulose Casings',
    label: 'STRIPED CELLULOSE',
    image: '/images/cellulose-casings-stripes.jpg',
    text: 'Striped Appearance · Decorative Sausage Presentation · Design Options Available on Request',
    href: '/en/cellulose-casings/striped/',
  },
  {
    id: 'transfer-color',
    title: 'Transfer-Color Cellulose Casings',
    label: 'TRANSFER-COLOR CELLULOSE',
    image: '/images/cellulose-casings-transfer.jpg',
    text: 'Transfer-Color Effect · Distinctive Surface Appearance · Product Options Available on Request',
    href: '/en/cellulose-casings/transfer-color/',
  },

];

---

<SiteLayout
  lang="en"
  title="Cellulose Casings | Haitu Casing"
  description="Explore Haitu cellulose casings, including transparent, colored, striped and transfer-color options for sausage processing."
>
  <section class="page-intro catalog-page-intro">
    <p class="eyebrow">Haitu Casings</p>
    <h1>Cellulose Casings</h1>
  </section>

  <section class="content-section plastic-catalog">
    <nav class="category-nav" aria-label="Product categories">
      <a class="category-link" href="/en/plastic-casings/">
        <span>Plastic Casings</span>
        <span class="category-arrow" aria-hidden="true">↗</span>
      </a>

      <a class="category-link" href="/en/collagen-casings/">
        <span>Collagen Casings</span>
        <span class="category-arrow" aria-hidden="true">↗</span>
      </a>

      <a
        class="category-link is-current"
        href="/en/cellulose-casings/"
        aria-current="page"
      >
        <span>Cellulose Casings</span>
        <span class="category-arrow" aria-hidden="true">↗</span>
      </a>

      <a class="category-link" href="/en/fibrous-casings/">
        <span>Fibrous Casings</span>
        <span class="category-arrow" aria-hidden="true">↗</span>
      </a>

      <a
        class="category-link"
        href="/en/food-processing-equipment/"
      >
        <span>Processing Equipment</span>
        <span class="category-arrow" aria-hidden="true">↗</span>
      </a>
    </nav>


    <div class="catalog-grid">
      {products.map((product) => (
        <article class="catalog-card" id={product.id}>
          <a class="product-image-link" href={product.href}>
            <img
              src={product.image}
              alt={product.title}
              loading="lazy"
            />
          </a>

          <div class="catalog-card-copy">
            <p class="eyebrow">{product.label}</p>
            <h2>
              <a href={product.href}>{product.title}</a>
            </h2>
            <p>{product.text}</p>
            <a class="text-link" href={product.href}>
              View product details →
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</SiteLayout>

<style>
  .plastic-catalog {
    max-width: none;
  }

.catalog-page-intro {
  background-image:
    linear-gradient(
      90deg,
      rgb(255 250 246 / 92%) 0%,
      rgb(255 250 246 / 75%) 45%,
      rgb(255 250 246 / 15%) 100%
    ),
    url('/images/hero-cellulose-casings.jpg');

  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;

  padding: 56px clamp(22px, 13.15vw, 176px);
  border-radius: 10px;
}

  .category-nav {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
    margin: -18px 0 98px;
    padding: 0;
  }

  .category-link {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    min-height: 30px;
    padding: 9px 12px;
    border: 1px solid #eadbd2;
    border-bottom: 3px solid #eadbd2;
    border-radius: 7px;
    background: #fffaf6;
    color: #1d3c59;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.35;
    text-decoration: none;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .category-number {
    flex: 0 0 auto;
    color: #c66a4e;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .category-arrow {
    flex: 0 0 auto;
    margin-left: auto;
    color: #c66a4e;
    font-size: 15px;
    transition: transform 0.2s ease;
  }

  .category-link:hover {
    border-color: #cf4438;
    border-bottom-color: #cf4438;
    background: #fff0e8;
    color: #a92f28;
    transform: translateY(-2px);
  }

  .category-link:hover .category-arrow {
    transform: translate(2px, -2px);
  }

  /* 当前页面：实心橙红色 */
  .category-nav .category-link.is-current,
  .category-nav .category-link.is-current:hover {
    border-color: #c93632;
    border-bottom-color: #a92327;
    background: #c93632;
    color: #fff;
    box-shadow: 0 4px 12px rgb(201 54 50 / 18%);
    transform: none;
  }

  .category-nav .category-link.is-current .category-number,
  .category-nav .category-link.is-current .category-arrow {
    color: #fff;
  }

  @media (max-width: 1050px) {
    .category-nav {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .category-nav {
      display: flex;
      gap: 10px;
      margin-bottom: 26px;
      padding: 3px 2px 12px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .category-link {
      flex: 0 0 auto;
      min-height: 56px;
      padding: 11px 13px;
      white-space: nowrap;
    }
  }
</style>
