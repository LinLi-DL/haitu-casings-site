---
import SiteLayout from '../../layouts/SiteLayout.astro';
const items = [
  { id: 'product-option-1', title: 'Cellulose Casings · Product option 1', text: 'Add the confirmed model name and specifications here.' },
  { id: 'product-option-2', title: 'Cellulose Casings · Product option 2', text: 'Add another confirmed model or size range here.' },
  { id: 'product-option-3', title: 'Cellulose Casings · Product option 3', text: 'Add further models only when supply and specifications are confirmed.' },
];
---
<SiteLayout lang="en" title="Cellulose Casings | Haitu Casing" description="Explore available cellulose casing options and confirm current supply details.">
  <section class="page-intro"><p class="eyebrow">Our products</p><h1>Cellulose Casings</h1><p>Explore available cellulose casing options and confirm current supply details. Haitu Casing supports B2B inquiries from sausage manufacturers and distributors.</p></section>
  <section class="content-section" style="max-width:none"><img src="/images/cellulose-casings-preview.jpg" alt="Cellulose Casings" style="width:100%;max-width:780px;border-radius:14px;display:block;margin-bottom:28px"/><h2>Available product options</h2><p class="catalog-intro">Contact us to confirm current availability, specifications, packaging and lead time for your requirements.</p><div class="catalog-grid">{items.map((item) => <article class="catalog-card"><img src="/images/cellulose-casings-preview.jpg" alt={item.title} loading="lazy"/><div class="catalog-card-copy"><h3>{item.title}</h3><p>{item.text}</p><a class="text-link" href={`#${item.id}`}>View product details →</a></div></article>)}</div>{items.map((item) => <section id={item.id} class="contact-card" style="margin:22px 0;scroll-margin-top:30px"><h2>{item.title}</h2><p>{item.text}</p><p>Share the caliber, packaging and estimated order quantity so we can confirm the available model and quotation.</p><a class="button button-red" href="/en/contact-us/">Request product details →</a></section>)}<div class="spec-note">The product options above are editable placeholders, not confirmed commercial model names. Replace them with verified models before publishing.</div></section>
</SiteLayout>
