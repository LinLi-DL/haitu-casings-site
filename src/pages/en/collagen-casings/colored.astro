---
import SiteLayout from '../../../layouts/SiteLayout.astro';

const product = {
  title: 'Colored Collagen Casings',
  subtitle: '',
  image: '/images/collagen-casings-colored.jpg',
};
---

<SiteLayout
  lang="en"
  title="Colored Collagen Casings | Haitu Casing"
  description="Colored collagen casings for sausage manufacturers seeking different product colors and visual presentations."
>
  <section class="page-intro product-page-intro">
    <p class="eyebrow">
      <a href="/en/collagen-casings/">Collagen Casings</a>
    </p>
    <h1>{product.title}</h1>
  </section>

  <section class="content-section product-overview">
    <div class="product-image">
      <img src={product.image} alt="Colored Collagen Casings" />
    </div>

    <div class="product-info">
      <h2>Product Description</h2>
      <p>
        Colored Collagen Casings are Suitable for cooked and snack sausages that require stable coloring. Colors can be customized based on actual requirements.
      </p>

      <h2>Application</h2>
      <p>
        Frankfurters, salami, semi-dried salami, beef sausage, snack sticks and other products requiring color.
      </p>

      <h2>Key Features</h2>
      <ul>
        <li>CUniform and stable coloring with low risk of fading during processing.</li>
        <li>Finished products maintain color well during storage.</li>
        <li>Suitable for steaming, deep frying and snack production processes.</li>
      </ul>
    </div>
  </section>

  <section class="content-section specifications">
    <h2>Specifications</h2>

    <div class="spec-table-wrap">
      <table class="spec-table">
        <tbody>
          <tr>
            <th>Type</th>
            <td>Colored collagen casing</td>
          </tr>
          <tr>
            <th>Colors</th>
            <td>Available colors to be confirmed</td>
          </tr>
          <tr>
            <th>Caliber</th>
            <td>16 - 34 mm</td>
          </tr>
          <tr>
            <th>Supply form</th>
            <td>Shirred (standard 15 m/stick)</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="cta product-cta">
    <div>
      <h2>Looking for a specific casing color?</h2>
      <p>
        Tell us your target color, sausage type, caliber and processing
        requirements so we can discuss available options.
      </p>
    </div>
    <a class="button button-red" href="/en/contact-us/">
      Contact Haitu Casing →
    </a>
  </section>
</SiteLayout>

<style>
  .product-intro .eyebrow a {
    color: var(--red);
  }

  .product-intro .product-subtitle {
    margin-top: 8px;
  }

  .product-overview {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 36px;
    align-items: start;
    max-width: 1280px;
  }

  .product-image img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .product-info h2,
  .specifications h2 {
    margin: 0 0 12px;
    color: var(--navy);
    font-size: clamp(21px, 2vw, 27px);
  }

  .product-info h2:not(:first-child) {
    margin-top: 24px;
  }

  .product-info p,
  .product-info ul,
  .product-cta p {
    color: var(--muted);
    line-height: 1.75;
  }

  .product-info ul {
    padding-left: 20px;
    margin-bottom: 0;
  }

  .product-info li + li {
    margin-top: 6px;
  }

  .specifications {
    max-width: 900px;
    padding-top: 12px;
  }

  .spec-table-wrap {
    overflow-x: auto;
  }

  .spec-table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--line);
  }

  .spec-table th,
  .spec-table td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .spec-table th {
    width: 32%;
    color: var(--navy);
    background: #f8f8f6;
    font-weight: 600;
  }

  .spec-table td {
    color: var(--muted);
  }

  .spec-table tr:last-child th,
  .spec-table tr:last-child td {
    border-bottom: 0;
  }

  .product-cta {
    margin-top: 28px;
  }

  @media (max-width: 720px) {
    .product-overview {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .product-image img {
      max-height: 480px;
      object-fit: contain;
    }

    .spec-table th,
    .spec-table td {
      padding: 10px 12px;
    }
  }
</style>