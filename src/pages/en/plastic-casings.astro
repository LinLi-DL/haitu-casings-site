---
import SiteLayout from '../../layouts/SiteLayout.astro';
const smokeProducts = [
  { title: 'HT Smoke', label: 'Smoke-Permeable Polymer Casing', image: '/images/ht-smoke.jpg', text: 'For semi-smoked and cooked-smoked sausages, frankfurters, wieners, mini-sausages and twisted products.', href: '/en/plastic-casings/ht-smoke/' },
  { title: 'HT Peel — Smoke-Permeable Easy-Peel', label: 'Easy-Peel Polymer Casing', image: '/images/ht-peel.jpg', text: 'For frankfurters and mini-sausages requiring automatic or semi-automatic peeling. Barrier and smoke-permeable versions are listed in the catalog.', href: '/en/plastic-casings/smoke-permeable-easy-peel/' },
];
const barrierProducts = [
  { title: 'HT Barrier Matte', label: 'Matte Finish', image: '/images/ht-barrier-matte.jpg', text: 'High-barrier casing for cooked sausages, hams, liver products and other non-smoked meat products.', href: '/en/plastic-casings/ht-barrier-matte/' },
  { title: 'HT Barrier Soft Matte', label: 'Soft Matte / Dull Finish', image: '/images/ht-barrier-soft-matte.jpg', text: 'A soft matte surface option for cooked sausages, hams, liver products and other non-smoked products.', href: '/en/plastic-casings/ht-barrier-soft-matte/' },
  { title: 'HT Barrier Pearl', label: 'Pearlescent Apricot Finish', image: '/images/ht-barrier-pearl.jpg', text: 'Three-layer high-barrier casing listed for frankfurters and mini-sausages.', href: '/en/plastic-casings/ht-barrier-pearl/' },
  { title: 'HT Standard', label: 'Standard High-Barrier', image: '/images/ht-standard.jpg', text: 'A standard high-barrier casing for cooked sausages, hams, liver sausages and pâté.', href: '/en/plastic-casings/ht-standard/' },
];
---
<SiteLayout lang="en" title="Plastic Casings | Haitu Casing" description="Explore Haitu plastic sausage casings, including smoke-permeable and high-barrier models with confirmed product catalog specifications.">
  <section class="page-intro"><p class="eyebrow">Haitu Plastic Casings</p><h1>Plastic Casings for Sausage Processing</h1><p>Our product catalog covers smoke-permeable and high-barrier polymer casings. Explore the individual models below for their listed applications, features, available specifications and supply forms.</p></section>
  <section class="content-section" style="max-width:none">
    <div class="series-block" id="smoke-permeable">
      <div class="series-heading"><div><p class="eyebrow">Series 01</p><h2>Smoke-Permeable Casings</h2><p>Options for semi-smoked and cooked-smoked products, including an easy-peel model for selected small sausages.</p></div></div>
      <div class="catalog-grid">{smokeProducts.map((p) => <article class="catalog-card"><a href={p.href}><img src={p.image} alt={p.title} loading="lazy" /></a><div class="catalog-card-copy"><p class="eyebrow">{p.label}</p><h3><a href={p.href}>{p.title}</a></h3><p>{p.text}</p><a class="text-link" href={p.href}>View product details →</a></div></article>)}</div>
    </div>
    <div class="series-block" id="high-barrier">
      <div class="series-heading"><div><p class="eyebrow">Series 02</p><h2>High-Barrier Casings</h2><p>Choose from matte, soft matte, pearlescent and standard high-barrier models. Product suitability and exact specifications should be confirmed for each order.</p></div></div>
      <div class="catalog-grid">{barrierProducts.map((p) => <article class="catalog-card"><a href={p.href}><img src={p.image} alt={p.title} loading="lazy" /></a><div class="catalog-card-copy"><p class="eyebrow">{p.label}</p><h3><a href={p.href}>{p.title}</a></h3><p>{p.text}</p><a class="text-link" href={p.href}>View product details →</a></div></article>)}</div>
    </div>
    <div class="spec-note">The product details follow the supplied HT Plastic Casing V2.0 catalog. Technical details not specified in that document, including full polymer composition and layer structure for most models, are not assumed here. Please confirm current specifications before ordering.</div>
  </section>
</SiteLayout>
<style>
.catalog-card .eyebrow {{ margin:0 0 7px; color:var(--red); font-size:10px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }}
.catalog-card h3 a {{ color:var(--navy); }}
.catalog-card img {{ object-fit:cover; }}
</style>
