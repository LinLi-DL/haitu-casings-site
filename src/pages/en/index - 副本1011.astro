---
import SiteLayout from '../../layouts/SiteLayout.astro';

const slides = [
  {
    image: '/images/ht-barrier-matte.jpg',
    alt: 'High-barrier matte plastic sausage casing',
    eyebrow: 'PLASTIC CASINGS',
    title: 'High-Barrier Matte Plastic Casings',
    text: 'High-barrier performance with a refined matte finish for cooked sausages, hams and other non-smoked meat products.',
    href: '/en/plastic-casings/ht-barrier-matte/',
    link: 'Explore Matte Casings',
    tone: 'light',
  },
  {
    image: '/images/ht-smoke.jpg',
    alt: 'Smoke-permeable plastic sausage casing',
    eyebrow: 'PLASTIC CASINGS',
    title: 'Smoke-Permeable Plastic Casings',
    text: 'Designed for smoked sausage applications where controlled smoke permeability and reliable processing performance matter.',
    href: '/en/plastic-casings/ht-smoke/',
    link: 'Explore Smoke Casings',
    tone: 'dark',
  },
  {
    image: '/images/hero-collagen-casings.jpg',
    alt: 'Collagen casings arranged for food processing',
    eyebrow: 'COLLAGEN CASINGS',
    title: 'Collagen Casings',
    text: 'A practical casing option for sausage producers. Contact our team to confirm available specifications and supply options.',
    href: '/en/collagen-casings/',
    link: 'Explore Collagen Casings',
    tone: 'light',
  },
  {
    image: '/images/hero-cellulose-casings.jpg',
    alt: 'Cellulose casings arranged for food processing',
    eyebrow: 'CELLULOSE CASINGS',
    title: 'Cellulose Casings',
    text: 'Casing solutions for suitable sausage-processing applications, with specifications and availability confirmed for each inquiry.',
    href: '/en/cellulose-casings/',
    link: 'Explore Cellulose Casings',
    tone: 'light',
  },
];

const products = [
  { title: 'Plastic Casings', image: '/images/ht-barrier-matte.jpg', text: 'High-barrier and smoke-permeable polymer casings for a range of processed meat applications.', href: '/en/plastic-casings/' },
  { title: 'Collagen Casings', image: '/images/collagen-casings-preview.jpg', text: 'Discuss your product requirements with our team to confirm suitable specifications.', href: '/en/collagen-casings/' },
  { title: 'Cellulose Casings', image: '/images/cellulose-casings-preview.jpg', text: 'Contact us for current availability, specifications and supply details.', href: '/en/cellulose-casings/' },
];
---

<SiteLayout lang="en" title="Haitu Casing | Sausage Casings for Food Processors" description="Haitu Technology supplies plastic, collagen and cellulose casings for sausage manufacturers and distributors, with product options for different processing requirements.">
  <section class="hero-carousel" data-hero-carousel aria-label="Featured casing products">
    {slides.map((slide, index) => (
      <article class:list={['hero-slide', slide.tone === 'dark' && 'hero-slide-dark', index === 0 && 'is-active']} data-hero-slide aria-hidden={index === 0 ? 'false' : 'true'}>
        <img class="hero-slide-image" src={slide.image} alt={slide.alt} fetchpriority={index === 0 ? 'high' : 'auto'} />
        <div class="hero-shade"></div>
        <div class="hero-content">
          <p class="hero-eyebrow">{slide.eyebrow}</p>
          <h1>{slide.title}</h1>
          <p class="hero-description">{slide.text}</p>
          <a class="button button-red hero-link" href={slide.href}>{slide.link} <span aria-hidden="true">→</span></a>
        </div>
      </article>
    ))}
    <button class="hero-arrow hero-prev" type="button" data-hero-prev aria-label="Previous product">‹</button>
    <button class="hero-arrow hero-next" type="button" data-hero-next aria-label="Next product">›</button>
    <div class="hero-pagination" aria-label="Choose featured product">
      {slides.map((slide, index) => <button type="button" class="hero-dot" data-hero-dot aria-label={`Show ${slide.title}`} aria-current={index === 0 ? 'true' : 'false'}></button>)}
    </div>
  </section>

  <section class="about-home" aria-labelledby="about-title">
    <div class="about-copy">
      <p class="eyebrow">ABOUT HAITU</p>
      <h2 id="about-title">Your Reliable Partner in Food Packaging Solutions</h2>
      <p>Haitu Technology supplies casing solutions for sausage manufacturers and food-processing businesses. We work with customers to identify suitable products for their applications, processing conditions and packaging requirements.</p>
      <p>From product selection and specification confirmation to quotation and order coordination, our team focuses on clear communication, dependable cooperation and practical solutions for international customers.</p>
      <a class="button button-red" href="/en/about-us/">Learn More About Us <span aria-hidden="true">→</span></a>
    </div>
    <div class="about-strengths">
      <article class="strength"><span class="strength-icon">✓</span><div><h3>Quality Focus</h3><p>Product details and requirements are carefully confirmed for each order.</p></div></article>
      <article class="strength"><span class="strength-icon">↗</span><div><h3>Reliable Cooperation</h3><p>Clear communication from initial inquiry through order coordination.</p></div></article>
      <article class="strength"><span class="strength-icon">◇</span><div><h3>Product Choices</h3><p>Plastic, collagen and cellulose casing categories for different needs.</p></div></article>
      <article class="strength"><span class="strength-icon">◎</span><div><h3>B2B Support</h3><p>Responsive support for sausage producers and casing distributors.</p></div></article>
    </div>
    <div class="about-image-wrap"><img src="/images/ht-printed-casing.jpg" alt="Printed plastic sausage casing product examples" loading="lazy" /></div>
  </section>

  <section class="products-home" id="products">
    <div class="section-heading"><div><p class="eyebrow">OUR PRODUCTS</p><h2>Featured Product Categories</h2><p class="section-intro">Casing options for sausage and processed meat manufacturers.</p></div></div>
    <div class="product-grid">{products.map((p) => <article class="product-card"><a class="product-image-link" href={p.href}><img src={p.image} alt={p.title} loading="lazy" /></a><div class="product-card-copy"><h3><a href={p.href}>{p.title}</a></h3><p>{p.text}</p><a class="text-link" href={p.href}>Explore Category <span aria-hidden="true">→</span></a></div></article>)}</div>
  </section>

  <section class="home-cta"><div><p class="eyebrow">LET'S TALK ABOUT YOUR REQUIREMENTS</p><h2>Looking for the right casing solution?</h2><p>Tell us about your product, target caliber, printing and supply requirements.</p></div><a class="button button-red" href="/en/contact-us/">Contact Haitu <span aria-hidden="true">→</span></a></section>
</SiteLayout>

<script>
  const carousel = document.querySelector('[data-hero-carousel]');
  if (carousel) {
    const slides = Array.from(carousel.querySelectorAll('[data-hero-slide]'));
    const dots = Array.from(carousel.querySelectorAll('[data-hero-dot]'));
    const prev = carousel.querySelector('[data-hero-prev]');
    const next = carousel.querySelector('[data-hero-next]');
    let active = 0;
    let timer;
    const show = (index) => {
      active = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === active);
        slide.setAttribute('aria-hidden', i === active ? 'false' : 'true');
      });
      dots.forEach((dot, i) => dot.setAttribute('aria-current', i === active ? 'true' : 'false'));
    };
    const restart = () => {
      window.clearInterval(timer);
      timer = window.setInterval(() => show(active + 1), 6000);
    };
    dots.forEach((dot, i) => dot.addEventListener('click', () => { show(i); restart(); }));
    prev?.addEventListener('click', () => { show(active - 1); restart(); });
    next?.addEventListener('click', () => { show(active + 1); restart(); });
    carousel.addEventListener('mouseenter', () => window.clearInterval(timer));
    carousel.addEventListener('mouseleave', restart);
    restart();
  }
</script>

<style>
.hero-carousel{position:relative;height:clamp(430px,40vw,590px);min-height:430px;overflow:hidden;background:#f8f5f0;color:#fff}
.hero-slide{position:absolute;inset:0;opacity:0;visibility:hidden;transition:opacity .65s ease;isolation:isolate}
.hero-slide.is-active{opacity:1;visibility:visible;z-index:1}
.hero-slide-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 52%;z-index:-2}
.hero-shade{position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(31,25,20,.72) 0%,rgba(43,31,23,.48) 40%,rgba(36,28,20,.08) 78%)}
.hero-slide-dark .hero-shade{background:linear-gradient(90deg,rgba(28,22,19,.78) 0%,rgba(44,27,20,.46) 43%,rgba(28,21,17,.08) 82%)}
.hero-content{position:relative;width:min(620px,62vw);padding:clamp(54px,8vw,112px) 0 80px clamp(24px,8vw,124px)}
.hero-eyebrow,.eyebrow{margin:0 0 14px;color:var(--orange);font-size:12px;font-weight:800;letter-spacing:1.7px;text-transform:uppercase}
.hero-content h1{margin:0 0 18px;font-size:clamp(34px,4.4vw,60px);line-height:1.08;letter-spacing:-1.2px;max-width:620px;color:#fff}
.hero-description{max-width:510px;margin:0 0 27px;color:rgba(255,255,255,.94);font-size:clamp(15px,1.25vw,18px);line-height:1.65}
.hero-link{display:inline-flex;align-items:center;gap:14px}.hero-arrow{position:absolute;z-index:3;top:50%;transform:translateY(-50%);width:46px;height:46px;border:1px solid rgba(255,255,255,.8);border-radius:50%;background:rgba(255,255,255,.92);color:var(--red);font-size:32px;line-height:1;cursor:pointer;box-shadow:0 3px 16px #0001}.hero-prev{left:22px}.hero-next{right:22px}.hero-arrow:hover{background:var(--orange);color:white;border-color:var(--orange)}
.hero-pagination{position:absolute;z-index:4;bottom:24px;left:50%;transform:translateX(-50%);display:flex;gap:10px}.hero-dot{width:10px;height:10px;padding:0;border:1px solid white;border-radius:50%;background:rgba(255,255,255,.5);cursor:pointer}.hero-dot[aria-current="true"]{width:27px;border-radius:8px;background:var(--orange);border-color:var(--orange)}
.about-home{display:grid;grid-template-columns:minmax(280px,1.08fr) minmax(280px,1fr) minmax(250px,.95fr);gap:clamp(24px,3vw,48px);align-items:center;padding:58px clamp(24px,6vw,92px);background:#fff}
.about-copy h2,.products-home h2,.home-cta h2{margin:0 0 18px;color:var(--navy);font-size:clamp(28px,3vw,40px);line-height:1.14;letter-spacing:-.7px}.about-copy>p:not(.eyebrow){font-size:14px;line-height:1.75;color:var(--muted)}.about-copy .button{margin-top:12px}
.about-strengths{display:grid;grid-template-columns:1fr 1fr;gap:25px 22px}.strength{display:flex;align-items:flex-start;gap:13px}.strength-icon{display:flex;flex:0 0 42px;width:42px;height:42px;align-items:center;justify-content:center;border-radius:50%;background:#fff2e8;color:var(--red);font-size:23px;font-weight:700}.strength h3{margin:3px 0 7px;color:var(--navy);font-size:15px}.strength p{margin:0;color:var(--muted);font-size:12px;line-height:1.65}
.about-image-wrap{height:300px;overflow:hidden;border-radius:5px 48px 5px 5px;position:relative}.about-image-wrap:before{content:"";position:absolute;inset:0 auto 0 0;width:6px;background:var(--orange);z-index:1}.about-image-wrap img{width:100%;height:100%;object-fit:cover}
.products-home{padding:52px clamp(24px,6vw,92px) 64px;background:#fffaf6}.section-heading{display:flex;align-items:end;justify-content:space-between;margin-bottom:24px}.products-home h2{margin-bottom:8px}.section-intro{margin:0;color:var(--muted);font-size:14px}.product-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.product-card{overflow:hidden;border:1px solid #f0e6dd;border-radius:10px;background:white;transition:transform .2s,box-shadow .2s}.product-card:hover{transform:translateY(-3px);box-shadow:0 12px 28px #6e39140f}.product-image-link{display:block;height:190px;overflow:hidden;background:#f7f4f0}.product-card img{width:100%;height:100%;object-fit:cover;transition:transform .35s}.product-card:hover img{transform:scale(1.035)}.product-card-copy{padding:20px 22px 23px}.product-card h3{margin:0 0 9px;font-size:20px;color:var(--navy)}.product-card p{min-height:48px;margin:0 0 16px;color:var(--muted);font-size:13px;line-height:1.65}.text-link{color:var(--red);font-size:13px;font-weight:750}.text-link:hover{color:var(--orange)}
.home-cta{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:35px clamp(24px,6vw,92px);background:#fff; border-top:1px solid #f1e7df}.home-cta h2{margin-bottom:8px;font-size:clamp(24px,2.4vw,32px)}.home-cta p:not(.eyebrow){margin:0;color:var(--muted);font-size:14px}.home-cta .eyebrow{margin-bottom:8px}
@media(max-width:980px){.about-home{grid-template-columns:1fr 1fr}.about-image-wrap{grid-column:1/-1;height:260px}.hero-content{width:72vw}.hero-carousel{height:500px}}
@media(max-width:640px){.hero-carousel{height:540px;min-height:540px}.hero-slide-image{object-position:60% center}.hero-shade,.hero-slide-dark .hero-shade{background:linear-gradient(90deg,rgba(29,22,17,.76),rgba(34,25,19,.42))}.hero-content{width:100%;padding:82px 26px 85px}.hero-content h1{font-size:37px}.hero-description{font-size:15px}.hero-prev{left:12px}.hero-next{right:12px}.hero-arrow{top:auto;bottom:15px;width:38px;height:38px;font-size:27px}.hero-pagination{bottom:29px}.about-home{grid-template-columns:1fr;padding:40px 22px;gap:30px}.about-strengths{gap:22px 14px}.about-image-wrap{grid-column:auto;height:230px}.products-home{padding:40px 22px}.product-grid{grid-template-columns:1fr;gap:16px}.product-image-link{height:210px}.product-card p{min-height:0}.home-cta{align-items:flex-start;flex-direction:column;padding:32px 22px}}
@media(prefers-reduced-motion:reduce){.hero-slide,.product-card,.product-card img{transition:none}}
</style>
