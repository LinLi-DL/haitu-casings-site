---
import SiteLayout from '../../layouts/SiteLayout.astro';
---

<SiteLayout
  lang="en"
  title="Contact Haitu Casing | Casing Inquiries & B2B Supply"
  description="Contact Haitu Technology for plastic, collagen, cellulose and fibrous sausage casings. Discuss product specifications, printing, samples and international supply."
>
  <section class="page-intro catalog-page-intro">
    <p class="eyebrow">Haitu Technology</p>
    <h1>Contact Us</h1>
  </section>

  <section class="content-section contact-section">
    <div class="contact-layout">
      <div class="contact-left">
<div class="contact-card">
  <p class="eyebrow">CONTACT DETAILS</p>
  <h2>Business Inquiries</h2>

  <div class="contact-item">
    <strong>Company</strong>
    <p>Haitu Technology Co., Ltd.</p>
    <p>Product brand: Haitu Casing</p>
  </div>

  <div class="contact-item">
    <strong>Contact</strong>
    <p>Maksim LI</p>
    <strong>Phone / WhatsApp</strong>
    <p><a href="tel:+8618561719122">+86 185 6171 9122</a></p>
    <strong>Email</strong>
    <p><a href="mailto:sales07@haitucasing.com">sales07@haitucasing.com</a></p>
  </div>

 
  <div class="contact-item">
    <strong>Address</strong>
    <p>
      Building 7, No. 20 Yuying Road, Shangma Street,
      Chengyang, Qingdao, China
    </p>
  </div>
</div>

        <div class="inquiry-card">
          <p class="section-kicker">FOR BUYERS & DISTRIBUTORS</p>
          <h2>Send an Inquiry</h2>
          <p class="form-intro">
            Select what you know so far. You can leave optional items blank
            and discuss the remaining details with us.
          </p>

          <form
            class="inquiry-form"
            action="mailto:maksimljc@163.com"
            method="post"
            enctype="text/plain"
          >
            <fieldset class="form-group">
              <legend><span>01</span> What products are you interested in?</legend>
              <div class="option-grid">
                <label class="option-card">
                  <input type="checkbox" name="Product" value="Plastic Casings" />
                  <span>Plastic Casings</span>
                </label>
                <label class="option-card">
                  <input type="checkbox" name="Product" value="Collagen Casings" />
                  <span>Collagen Casings</span>
                </label>
                <label class="option-card">
                  <input type="checkbox" name="Product" value="Cellulose Casings" />
                  <span>Cellulose Casings</span>
                </label>
                <label class="option-card">
                  <input type="checkbox" name="Product" value="Fibrous Casings" />
                  <span>Fibrous Casings</span>
                </label>
                <label class="option-card">
                  <input type="checkbox" name="Product" value="Processing Equipment" />
                  <span>Processing Equipment</span>
                </label>
                <label class="option-card">
                  <input type="checkbox" name="Product" value="Not Sure Yet" />
                  <span>Not Sure Yet</span>
                </label>
              </div>
            </fieldset>

            <fieldset class="form-group">
              <legend><span>02</span> What best describes your business?</legend>
              <div class="option-grid option-grid-three">
                <label class="option-card">
                  <input type="checkbox" name="Business Type" value="Sausage Manufacturer" />
                  <span>Sausage Manufacturer</span>
                </label>
                <label class="option-card">
                  <input type="checkbox" name="Business Type" value="Distributor" />
                  <span>Distributor</span>
                </label>
                <label class="option-card">
                  <input type="checkbox" name="Business Type" value="Trading Company" />
                  <span>Trading Company</span>
                </label>
              </div>
            </fieldset>

            <fieldset class="form-group">
              <legend><span>03</span> Which specifications matter to you?</legend>
              <div class="option-grid">
                <label class="option-card">
                  <input type="checkbox" name="Requirements" value="Caliber / Flat Width" />
                  <span>Caliber / Flat Width</span>
                </label>
                <label class="option-card">
                  <input type="checkbox" name="Requirements" value="Color / Surface Finish" />
                  <span>Color / Surface Finish</span>
                </label>
                <label class="option-card">
                  <input type="checkbox" name="Requirements" value="Printing" />
                  <span>Printing</span>
                </label>
                <label class="option-card">
                  <input type="checkbox" name="Requirements" value="Easy Peeling" />
                  <span>Easy Peeling</span>
                </label>
                <label class="option-card">
                  <input type="checkbox" name="Requirements" value="Smoke Permeability" />
                  <span>Smoke Permeability</span>
                </label>
                <label class="option-card">
                  <input type="checkbox" name="Requirements" value="Barrier Performance" />
                  <span>Barrier Performance</span>
                </label>
              </div>
            </fieldset>

            <fieldset class="form-group">
              <legend><span>04</span> Order information</legend>

              <div class="option-grid option-grid-three">
                <label class="option-card">
                  <input type="checkbox" name="Supply Form" value="Shirred Sticks" />
                  <span>Shirred Sticks</span>
                </label>
                <label class="option-card">
                  <input type="checkbox" name="Supply Form" value="Rolls" />
                  <span>Rolls</span>
                </label>
                <label class="option-card">
                  <input type="checkbox" name="Supply Form" value="Either Form" />
                  <span>Either Form</span>
                </label>
              </div>

              <div class="form-fields">
                <label class="field">
                  <span>Estimated Quantity</span>
                  <input
                    type="text"
                    name="Estimated Quantity"
                    placeholder="e.g. 10,000 meters / month"
                  />
                </label>
                <label class="field">
                  <span>Destination Country</span>
                  <input
                    type="text"
                    name="Destination Country"
                    placeholder="Where will the goods be delivered?"
                  />
                </label>
              </div>
            </fieldset>

            <div class="contact-form-fields">
              <h3>Your Contact Details</h3>
              <p>Please leave your contact information so we can reply.</p>

              <div class="form-fields">
                <label class="field">
                  <span>Name <b>*</b></span>
                  <input
                    type="text"
                    name="Name"
                    autocomplete="name"
                    placeholder="Your name"
                    required
                  />
                </label>
                <label class="field">
                  <span>Company</span>
                  <input
                    type="text"
                    name="Company"
                    autocomplete="organization"
                    placeholder="Company name"
                  />
                </label>
                <label class="field">
                  <span>Email <b>*</b></span>
                  <input
                    type="email"
                    name="Email"
                    autocomplete="email"
                    placeholder="name@company.com"
                    required
                  />
                </label>
                <label class="field">
                  <span>WhatsApp / Phone</span>
                  <input
                    type="text"
                    name="WhatsApp / Phone"
                    autocomplete="tel"
                    placeholder="Include country code"
                  />
                </label>
              </div>

              <label class="field message-field">
                <span>Additional Notes <small>(Optional)</small></span>
                <textarea
                  name="Additional Notes"
                  rows="3"
                  placeholder="Product details, current casing, questions or anything else you would like to share."
                ></textarea>
              </label>
            </div>

            <button class="button button-red submit-button" type="submit">
              Send Inquiry <span aria-hidden="true">→</span>
            </button>
            <p class="form-footnote">
              Have a product photo or existing casing specification?
              You can also email it directly to us.
            </p>
          </form>
        </div>
      </div>

      <aside class="contact-right">
        <div class="map-card">
          <div class="map-heading">
            <div>
              <p class="section-kicker">OUR LOCATION</p>
              <h2>Based in Qingdao, China</h2>
            </div>
            <a
              class="map-link"
              href="https://www.google.com/maps/search/?api=1&query=Building+7%2C+No.+20+Yuying+Road%2C+Chengyang%2C+Qingdao%2C+China"
              target="_blank"
              rel="noopener noreferrer"
            >
              Open in Maps ↗
            </a>
          </div>

          <iframe
            class="location-map"
            title="Map showing Haitu Technology's location in Qingdao, China"
            src="https://maps.google.com/maps?q=Chengyang%2C%20Qingdao%2C%20China&t=&z=12&ie=UTF8&iwloc=&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>

          <div class="map-caption">
            <span class="map-dot"></span>
            <div>
              <strong>Haitu Technology Co., Ltd.</strong>
              <p>Qingdao, China · International casing supply</p>
            </div>
          </div>
        </div>

        <div class="markets-card">
          <p class="section-kicker">OUR MARKETS</p>
          <h2>Connecting China with Global Casing Markets</h2>
          <p>
            We coordinate casing supply for sausage manufacturers and
            distributors across established and developing markets.
          </p>

          <div class="market-tags" aria-label="Markets served">
            <span class="market-priority">Russia</span>
            <span class="market-priority">Central Asia</span>
            <span>North America</span>
            <span>Europe</span>
            <span>Southeast Asia</span>
            <span>South America</span>
          </div>

          <div class="market-route" aria-label="Illustration of international supply routes">
            <svg viewBox="0 0 520 250" role="img" aria-labelledby="route-title route-desc">
              <title id="route-title">Haitu's international casing supply routes</title>
              <desc id="route-desc">
                Fine curved lines connect Qingdao in China with Russia and Central Asia
                more prominently, as well as North America, Europe, Southeast Asia and
                South America.
              </desc>

              <defs>
                <pattern id="map-dots" width="13" height="13" patternUnits="userSpaceOnUse">
                  <circle cx="1.5" cy="1.5" r="1" fill="#e9d9cf" />
                </pattern>
              </defs>

              <rect width="520" height="250" rx="12" fill="url(#map-dots)" />

              <g fill="#eaded5" opacity=".8">
                <path d="M40 55 L66 35 L106 40 L122 61 L110 80 L83 87 L70 112 L48 105 L36 80 Z" />
                <path d="M96 125 L120 136 L132 164 L119 190 L111 223 L98 203 L94 174 L84 154 Z" />
                <path d="M221 56 L245 44 L267 53 L263 70 L244 78 L228 70 Z" />
                <path d="M239 85 L260 90 L273 111 L266 134 L252 154 L239 141 L231 115 Z" />
                <path d="M280 59 L312 45 L351 49 L376 42 L407 54 L438 58 L465 77 L451 94 L420 96 L401 111 L378 103 L356 115 L331 102 L309 95 L290 78 Z" />
                <path d="M410 157 L431 148 L449 160 L440 178 L422 183 Z" />
                <path d="M461 198 L481 190 L497 203 L485 217 L469 216 Z" />
              </g>

              <g fill="none" stroke="#d94a3f" stroke-linecap="round">
                <path d="M350 88 Q322 22 282 62" stroke-width="1.8" stroke-dasharray="3 5" opacity=".9" />
                <path d="M350 88 Q313 54 290 88" stroke-width="1.8" stroke-dasharray="3 5" opacity=".9" />
                <path d="M350 88 Q310 102 290 88" stroke-width="1.8" stroke-dasharray="3 5" opacity=".75" />
                <path d="M350 88 Q335 128 370 150" stroke-width="1.2" stroke-dasharray="3 5" opacity=".8" />
                <path d="M350 88 Q286 7 165 74" stroke-width="1.3" stroke-dasharray="3 5" opacity=".65" />
                <path d="M350 88 Q420 119 432 166" stroke-width="1.2" stroke-dasharray="3 5" opacity=".75" />
                <path d="M350 88 Q396 151 478 205" stroke-width="1.2" stroke-dasharray="3 5" opacity=".75" />
                <path d="M350 88 Q290 156 110 166" stroke-width="1.1" stroke-dasharray="3 5" opacity=".65" />
                <path d="M350 88 Q400 64 444 77" stroke-width="1.1" stroke-dasharray="3 5" opacity=".6" />
                <path d="M350 88 Q348 42 323 49" stroke-width="1.2" stroke-dasharray="3 5" opacity=".85" />
                <path d="M350 88 Q310 78 278 73" stroke-width="1.2" stroke-dasharray="3 5" opacity=".8" />
                <path d="M350 88 Q318 112 302 102" stroke-width="1.2" stroke-dasharray="3 5" opacity=".8" />
                <path d="M350 88 Q388 104 401 122" stroke-width="1.2" stroke-dasharray="3 5" opacity=".75" />
              </g>

              <g fill="#d94339" stroke="#fffaf6" stroke-width="2">
                <circle cx="165" cy="74" r="3.5" />
                <circle cx="282" cy="62" r="3.5" />
                <circle cx="290" cy="88" r="3.5" />
                <circle cx="370" cy="150" r="3" />
                <circle cx="432" cy="166" r="3" />
                <circle cx="478" cy="205" r="3" />
                <circle cx="110" cy="166" r="3" />
                <circle cx="444" cy="77" r="3" />
              </g>

              <circle cx="350" cy="88" r="7" fill="#d94339" stroke="#fffaf6" stroke-width="3" />
              <circle cx="350" cy="88" r="12" fill="none" stroke="#d94339" stroke-opacity=".22" stroke-width="2" />

              <g fill="#1d3c59" font-family="Arial, sans-serif" font-size="10" font-weight="700">
                <text x="131" y="64">NORTH AMERICA</text>
                <text x="269" y="47">RUSSIA</text>
                <text x="244" y="105">CENTRAL ASIA</text>
                <text x="359" y="81" fill="#c93632">QINGDAO</text>
                <text x="393" y="142" font-size="8" font-weight="400">SOUTHEAST ASIA</text>
                <text x="439" y="184" font-size="8" font-weight="400">SOUTH AMERICA</text>
                <text x="407" y="65" font-size="8" font-weight="400">EUROPE</text>
              </g>
            </svg>
          </div>
        </div>
      </aside>
    </div>
  </section>
</SiteLayout>

<style>

  .page-intro {
  max-width: none;
  margin: 0 auto;
}

.catalog-page-intro {
  background-image:
    linear-gradient(
      90deg,
      rgb(255 250 246 / 92%) 0%,
      rgb(255 250 246 / 75%) 45%,
      rgb(255 250 246 / 15%) 100%
    ),
    url('/images/about-factory.jpg');

  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;

  padding: 56px clamp(22px, 13.15vw, 176px);
  border-radius: 10px;
}

.page-intro h1 {
  max-width: 900px;
  margin: 0 0 18px;
  color: var(--navy);
  font-size: clamp(34px, 4.2vw, 52px);
  line-height: 1.1;
  letter-spacing: -1px;
}

.page-intro > p:not(.eyebrow) {
  max-width: 780px;
  margin: 0;
  color: var(--muted);
  font-size: 16px;
  line-height: 1.8;
}

@media (max-width: 760px) {
  .page-intro {
    padding: 40px 22px 30px;
  }

  .page-intro h1 {
    font-size: clamp(31px, 8vw, 40px);
  }

  .page-intro > p:not(.eyebrow) {
    font-size: 14px;
  }
}

  .contact-section {
    max-width: none;
    padding-top: 0;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: 28px;
  }

  .contact-left,
  .contact-right {
    display: grid;
    gap: 22px;
    min-width: 0;
  }

  .contact-card,

.contact-card {
  min-width: 0;
  padding: 30px 34px;
  border: 1px solid #f0ded3;
  border-radius: 10px;
  background: #fff;
}

.contact-card > .eyebrow {
  margin: 0 0 10px;
  color: var(--red);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.contact-card h2 {
  margin: 0 0 22px;
  color: var(--navy);
  font-size: 27px;
  line-height: 1.25;
}

.contact-item {
  padding: 10px 0;
  border-top: none;
}

.contact-item strong {
  display: block;
  margin-bottom: 7px;
  color: var(--navy);
  font-size: 14px;
  font-weight: 700;
}

.contact-item p {
  margin: 4px 0;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.7;
  overflow-wrap: anywhere;
}

.contact-item a {
  color: var(--red);
  text-decoration: none;
}

.contact-item a:hover {
  text-decoration: underline;
}

@media (max-width: 680px) {
  .contact-card {
    padding: 24px 20px;
  }

  .contact-card h2 {
    font-size: 24px;
  }
}



  .inquiry-card,
  .map-card,
  .markets-card {
    min-width: 0;
    border: 1px solid #f0ded3;
    border-radius: 12px;
    background: #fff;
    padding: clamp(22px, 2.4vw, 34px);
  }

  .section-kicker {
    margin: 0 0 10px;
    color: var(--red);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
    line-height: 1.5;
  }

  .contact-card h2,
  .inquiry-card h2,
  .map-card h2,
  .markets-card h2 {
    margin: 0;
    color: var(--navy);
    font-size: clamp(23px, 2.3vw, 30px);
    line-height: 1.2;
    letter-spacing: -0.45px;
  }

  .contact-item {
    margin-top: 18px;
    padding-top: 17px;
    border-top: 1px solid #e8edf0;
  }

  .contact-label {
    display: block;
    margin-bottom: 7px;
    color: var(--navy);
    font-size: 13px;
    font-weight: 800;
  }

  .contact-item p {
    margin: 0 0 5px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .contact-item a {
    color: var(--red);
    text-decoration: none;
  }

  .contact-item a:hover {
    text-decoration: underline;
  }

  .inquiry-card {
    background: #fffaf6;
  }

  .form-intro,
  .contact-form-fields > p {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.75;
  }

  .inquiry-form {
    margin-top: 22px;
  }

  .form-group {
    min-width: 0;
    margin: 0;
    padding: 20px 0;
    border: 0;
    border-top: 1px solid #efdfd5;
  }

  .form-group legend {
    width: 100%;
    padding: 0 0 13px;
    color: var(--navy);
    font-size: 15px;
    font-weight: 800;
    line-height: 1.5;
  }

  .form-group legend span {
    display: inline-block;
    margin-right: 10px;
    color: #c66a4e;
    font-size: 12px;
    letter-spacing: 0.5px;
  }

  .option-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px;
  }

  .option-grid-three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .option-card {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    min-width: 0;
    padding: 11px 12px;
    border: 1px solid #eadbd2;
    border-radius: 7px;
    background: #fff;
    color: #41566a;
    cursor: pointer;
    font-size: 12px;
    line-height: 1.5;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .option-card:hover {
    border-color: #d77a61;
    background: #fff5ef;
  }

  .option-card:has(input:checked) {
    border-color: #c93632;
    background: #fff0e9;
    color: #9f2d28;
  }

  .option-card input {
    flex: 0 0 auto;
    width: 15px;
    height: 15px;
    margin: 2px 0 0;
    accent-color: #c93632;
  }

  .form-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 15px;
    margin-top: 15px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 0;
  }

  .field > span {
    color: var(--navy);
    font-size: 12px;
    font-weight: 800;
  }

  .field b {
    color: var(--red);
  }

  .field small {
    color: var(--muted);
    font-size: 11px;
    font-weight: 400;
  }

  .field input,
  .field textarea {
    display: block;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    padding: 12px 13px;
    border: 1px solid #e2d8d2;
    border-radius: 6px;
    outline: none;
    background: #fff;
    color: var(--navy);
    font: inherit;
    font-size: 13px;
    line-height: 1.5;
  }

  .field input:focus,
  .field textarea:focus {
    border-color: #cf4438;
    box-shadow: 0 0 0 3px rgb(207 68 56 / 9%);
  }

  .field textarea {
    resize: vertical;
  }

  .contact-form-fields {
    padding-top: 22px;
    border-top: 1px solid #efdfd5;
  }

  .contact-form-fields h3 {
    margin: 0;
    color: var(--navy);
    font-size: 20px;
    line-height: 1.3;
  }

  .message-field {
    margin-top: 17px;
  }

  .submit-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-width: 190px;
    margin-top: 22px;
    border: 0;
    cursor: pointer;
  }

  .form-footnote {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.65;
  }

  .map-card {
    padding: 0;
    overflow: hidden;
  }

  .map-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 24px 25px 20px;
  }

  .map-heading h2 {
    font-size: clamp(21px, 2vw, 27px);
  }

  .map-link {
    flex: 0 0 auto;
    padding: 9px 11px;
    border: 1px solid #eadbd2;
    border-radius: 5px;
    color: var(--red);
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
  }

  .location-map {
    display: block;
    width: 100%;
    height: 360px;
    border: 0;
    background: #f7f2ee;
  }

  .map-caption {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    padding: 17px 25px 21px;
  }

  .map-dot {
    flex: 0 0 auto;
    width: 9px;
    height: 9px;
    margin-top: 5px;
    border-radius: 50%;
    background: #c93632;
    box-shadow: 0 0 0 4px #fbe8e1;
  }

  .map-caption strong {
    color: var(--navy);
    font-size: 13px;
  }

  .map-caption p {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.6;
  }

  .markets-card {
    background: #fffaf6;
  }

  .markets-card > p:not(.section-kicker) {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.75;
  }

  .market-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }

  .market-tags span {
    padding: 7px 10px;
    border: 1px solid #eadbd2;
    border-radius: 5px;
    background: #fff;
    color: #526779;
    font-size: 11px;
