---
import SiteLayout from '../../layouts/SiteLayout.astro';

const slides = [
  {
    image: '/images/ht-barrier-matte.jpg',
    alt: 'High-barrier matte polyamide sausage casings',
    eyebrow: 'POLYAMIDE CASINGS',
    title: 'Polyamide Casings',
    text: 'High-barrier matte and smoke-permeable options for cooked and smoked sausage applications. Tell us your product and processing requirements so we can help identify a suitable option.',
    href: '/en/plastic-casings/',
    link: 'Explore Polyamide Casings',
    tone: 'light',
  },
  {
    image: '/images/hero-collagen-casings.jpg',
    alt: 'Collagen sausage casings arranged for food processing',
    eyebrow: 'COLLAGEN CASINGS',
    title: 'Collagen Casings',
    text: 'Casing options for sausage producers seeking practical processing performance. Contact our team to confirm available calibers and specifications.',
    href: '/en/collagen-casings/',
    link: 'Explore Collagen Casings',
    tone: 'light',
  },
  {
    image: '/images/hero-cellulose-casings.jpg',
    alt: 'Cellulose sausage casings prepared for food processing',
    eyebrow: 'CELLULOSE CASINGS',
    title: 'Cellulose Casings',
    text: 'Cellulose casing solutions for suitable sausage-processing applications, with product specifications and availability confirmed for each inquiry.',
    href: '/en/cellulose-casings/',
    link: 'Explore Cellulose Casings',
    tone: 'light',
  },
  {
    image: '/images/hero-fibrous-casings.jpg',
    alt: 'Fibrous sausage casings for larger-caliber processed meat products',
    eyebrow: 'FIBROUS CASINGS',
    title: 'Fibrous Casings',
    text: 'A casing option for selected larger-caliber sausage and processed-meat products. Share your product type and caliber so we can confirm suitability.',
    href: '/en/fibrous-casings/',
    link: 'Explore Fibrous Casings',
    tone: 'light',
  },
];

const products = [
  { title: 'Polyamide Casings', image: '/images/ht-barrier-matte.jpg', text: 'High-barrier matte and smoke-permeable options for cooked and smoked sausage applications.', href: '/en/plastic-casings/' },
  { title: 'Collagen Casings', image: '/images/collagen-casings-preview.jpg', text: 'Casing options for sausage producers. Contact us to confirm available specifications and supply options.', href: '/en/collagen-casings/' },
  { title: 'Cellulose Casings', image: '/images/cellulose-casings-preview.jpg', text: 'Casing solutions for suitable sausage-processing applications, with availability confirmed for each inquiry.', href: '/en/cellulose-casings/' },
  { title: 'Fibrous Casings', image: '/images/hero-fibrous-casings.jpg', text: 'A casing category for selected larger-caliber sausage and processed-meat products.', href: '/en/fibrous-casings/' },
];
---

<SiteLayout lang="en" title="Haitu Casing | Sausage Casings for Food Processors" description="Haitu Technology supplies polyamide, collagen, cellulose and fibrous casings for sausage manufacturers and distributors, with product options for different processing requirements.">
  <section class="hero-carousel" data-hero-carousel aria-label="Featured casing products">
    {slides.map((slide, index) => (
      <article class:list={['hero-slide', slide.tone === 'dark' && 'hero-slide-dark', index === 0 && 'is-active']} data-hero-slide aria-hidden={index === 0 ? 'false' : 'true'}>
        <img class="hero-slide-image" src={slide.image} alt={slide.alt} fetchpriority={index === 0 ? 'high' : 'auto'} />
        <div class="hero-shade"></div>
        <div class="hero-content">
          <p class="hero-eyebrow">{slide.eyebrow}</p>
          <h1>{slide.title}</h1>
          <p class="hero-description">{slide.text}</p>
          <a class="button button-red hero-link" href={slide.href}>{slide.link} <span aria-hidden="true">→</span></a>
        </div>
      </article>
    ))}
    <button class="hero-arrow hero-prev" type="button" data-hero-prev aria-label="Previous product">‹</button>
    <button class="hero-arrow hero-next" type="button" data-hero-next aria-label="Next product">›</button>
    <div class="hero-pagination" aria-label="Choose featured product">
      {slides.map((slide, index) => <button type="button" class="hero-dot" data-hero-dot aria-label={`Show ${slide.title}`} aria-current={index === 0 ? 'true' : 'false'}></button>)}
    </div>
  </section>

  <section class="about-home" aria-labelledby="about-title">
    <div class="about-copy">
      <p class="eyebrow">ABOUT HAITU</p>
      <h2 id="about-title">Your Reliable Partner in Food Packaging Solutions</h2>
      <p>Haitu Technology supplies casing solutions for sausage manufacturers and food-processing businesses. We work with customers to identify suitable products for their applications, processing conditions and packaging requirements.</p>
      <p>From product selection and specification confirmation to quotation and order coordination, our team focuses on clear communication, dependable cooperation and practical solutions for international customers.</p>
      <a class="button button-red" href="/en/about-us/">Learn More About Us <span aria-hidden="true">→</span></a>
    </div>
    <div class="about-right">
    <div class="about-image-wrap" data-about-carousel aria-label="Haitu operations and services">
      <div class="about-image-slide is-active" data-about-slide aria-hidden="false">
        <img src="/images/about-factory.jpg" alt="Haitu partner factory and production facilities" loading="lazy" />
        <span class="about-image-caption">Production & Quality</span>
      </div>
      <div class="about-image-slide" data-about-slide aria-hidden="true">
        <img src="/images/about-logistics.jpg" alt="Casing products prepared for export shipment" loading="lazy" />
        <span class="about-image-caption">Export Logistics</span>
      </div>
      <div class="about-image-slide" data-about-slide aria-hidden="true">
        <img src="/images/about-equipment.jpg" alt="Sausage casing processing and stuffing equipment" loading="lazy" />
        <span class="about-image-caption">Processing Applications</span>
      </div>
      <div class="about-image-controls" aria-label="About images">
        <button type="button" data-about-prev aria-label="Previous About image">‹</button>
        <div class="about-image-dots">
          <button type="button" data-about-dot aria-label="Show factory image" aria-current="true"></button>
          <button type="button" data-about-dot aria-label="Show logistics image" aria-current="false"></button>
          <button type="button" data-about-dot aria-label="Show equipment image" aria-current="false"></button>
        </div>
        <button type="button" data-about-next aria-label="Next About image">›</button>
      </div>
    </div>
    <div class="about-strengths">
      <article class="strength"><span class="strength-icon">✓</span><div><h3>Quality Focus</h3><p>Product details and requirements are carefully confirmed for each order.</p></div></article>
      <article class="strength"><span class="strength-icon">↗</span><div><h3>Reliable Cooperation</h3><p>Clear communication from initial inquiry through order coordination.</p></div></article>
      <article class="strength"><span class="strength-icon">◇</span><div><h3>Product Choices</h3><p>Plastic, collagen and cellulose casing categories for different needs.</p></div></article>
      <article class="strength"><span class="strength-icon">◎</span><div><h3>B2B Support</h3><p>Responsive support for sausage producers and casing distributors.</p></div></article>
    </div>
    </div>
  </section>

  <section class="products-home" id="products">
    <div class="section-heading"><div><p class="eyebrow">OUR PRODUCTS</p><h2>Our Casing Categories</h2><p class="section-intro">Casing options for sausage and processed meat manufacturers.</p></div></div>
    <div class="product-grid">{products.map((p) => <article class="product-card"><a class="product-image-link" href={p.href}><img src={p.image} alt={p.title} loading="lazy" /></a><div class="product-card-copy"><h3><a href={p.href}>{p.title}</a></h3><p>{p.text}</p><a class="text-link" href={p.href}>Explore Category <span aria-hidden="true">→</span></a></div></article>)}</div>
  </section>

  <section class="home-cta"><div><p class="eyebrow">LET'S TALK ABOUT YOUR REQUIREMENTS</p><h2>Looking for the right casing solution?</h2><p>Tell us about your product, target caliber, printing and supply requirements.</p></div><a class="button button-red" href="/en/contact-us/">Contact Haitu <span aria-hidden="true">→</span></a></section>
</SiteLayout>

<script>
  const carousel = document.querySelector('[data-hero-carousel]');
  if (carousel) {
    const slides = Array.from(carousel.querySelectorAll('[data-hero-slide]'));
    const dots = Array.from(carousel.querySelectorAll('[data-hero-dot]'));
    const prev = carousel.querySelector('[data-hero-prev]');
    const next = carousel.querySelector('[data-hero-next]');
    let active = 0;
    let timer;
    const show = (index) => {
      active = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === active);
        slide.setAttribute('aria-hidden', i === active ? 'false' : 'true');
      });
      dots.forEach((dot, i) => dot.setAttribute('aria-current', i === active ? 'true' : 'false'));
    };
    const restart = () => {
      window.clearInterval(timer);
      timer = window.setInterval(() => show(active + 1), 6000);
    };
    dots.forEach((dot, i) => dot.addEventListener('click', () => { show(i); restart(); }));
    prev?.addEventListener('click', () => { show(active - 1); restart(); });
    next?.addEventListener('click', () => { show(active + 1); restart(); });
    carousel.addEventListener('mouseenter', () => window.clearInterval(timer));
    carousel.addEventListener('mouseleave', restart);
    restart();
  }

  // About image carousel: three slides, independent from the main hero carousel.
  const aboutCarousel = document.querySelector('[data-about-carousel]');
  if (aboutCarousel) {
    const aboutSlides = Array.from(aboutCarousel.querySelectorAll('[data-about-slide]'));
    const aboutDots = Array.from(aboutCarousel.querySelectorAll('[data-about-dot]'));
    const aboutPrev = aboutCarousel.querySelector('[data-about-prev]');
    const aboutNext = aboutCarousel.querySelector('[data-about-next]');
    let aboutActive = 0;
    let aboutTimer;

    const showAboutSlide = (index) => {
      aboutActive = (index + aboutSlides.length) % aboutSlides.length;
      aboutSlides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === aboutActive);
        slide.setAttribute('aria-hidden', i === aboutActive ? 'false' : 'true');
      });
      aboutDots.forEach((dot, i) => dot.setAttribute('aria-current', i === aboutActive ? 'true' : 'false'));
    };
    const restartAboutTimer = () => {
      window.clearInterval(aboutTimer);
      aboutTimer = window.setInterval(() => showAboutSlide(aboutActive + 1), 5000);
    };
    aboutDots.forEach((dot, i) => dot.addEventListener('click', () => { showAboutSlide(i); restartAboutTimer(); }));
    aboutPrev?.addEventListener('click', () => { showAboutSlide(aboutActive - 1); restartAboutTimer(); });
    aboutNext?.addEventListener('click', () => { showAboutSlide(aboutActive + 1); restartAboutTimer(); });
    aboutCarousel.addEventListener('mouseenter', () => window.clearInterval(aboutTimer));
    aboutCarousel.addEventListener('mouseleave', restartAboutTimer);
    restartAboutTimer();
  }
</script>

<style>
.hero-carousel{position:relative;height:clamp(430px,40vw,590px);min-height:430px;overflow:hidden;background:#f8f5f0;color:#fff}
.hero-slide{position:absolute;inset:0;opacity:0;visibility:hidden;transition:opacity .65s ease;isolation:isolate}
.hero-slide.is-active{opacity:1;visibility:visible;z-index:1}
.hero-slide-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 52%;z-index:-2}
.hero-shade{position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(31,25,20,.72) 0%,rgba(43,31,23,.48) 40%,rgba(36,28,20,.08) 78%)}
.hero-slide-dark .hero-shade{background:linear-gradient(90deg,rgba(28,22,19,.78) 0%,rgba(44,27,20,.46) 43%,rgba(28,21,17,.08) 82%)}
.hero-content{position:relative;width:min(620px,62vw);padding:clamp(54px,8vw,112px) 0 80px clamp(24px,8vw,124px)}
.hero-eyebrow,.eyebrow{margin:0 0 14px;color:var(--orange);font-size:12px;font-weight:800;letter-spacing:1.7px;text-transform:uppercase}
.hero-content h1{margin:0 0 18px;font-size:clamp(34px,4.4vw,60px);line-height:1.08;letter-spacing:-1.2px;max-width:620px;color:#fff}
.hero-description{max-width:510px;margin:0 0 27px;color:rgba(255,255,255,.94);font-size:clamp(15px,1.25vw,18px);line-height:1.65}
.hero-link{display:inline-flex;align-items:center;gap:14px}.hero-arrow{position:absolute;z-index:3;top:50%;transform:translateY(-50%);width:46px;height:46px;border:1px solid rgba(255,255,255,.8);border-radius:50%;background:rgba(255,255,255,.92);color:var(--red);font-size:32px;line-height:1;cursor:pointer;box-shadow:0 3px 16px #0001}.hero-prev{left:22px}.hero-next{right:22px}.hero-arrow:hover{background:var(--orange);color:white;border-color:var(--orange)}
.hero-pagination{position:absolute;z-index:4;bottom:24px;left:50%;transform:translateX(-50%);display:flex;gap:10px}.hero-dot{width:10px;height:10px;padding:0;border:1px solid white;border-radius:50%;background:rgba(255,255,255,.5);cursor:pointer}.hero-dot[aria-current="true"]{width:27px;border-radius:8px;background:var(--orange);border-color:var(--orange)}
.about-home{display:grid;grid-template-columns:minmax(330px,0.9fr) minmax(0,1.6fr);gap:clamp(28px,3.4vw,54px);align-items:center;padding:58px clamp(24px,6vw,92px);background:#fff}
.about-right{display:flex;flex-direction:column;gap:20px;min-width:0;width:100%}
.about-copy h2,.products-home h2,.home-cta h2{margin:0 0 18px;color:var(--navy);font-size:clamp(28px,3vw,40px);line-height:1.14;letter-spacing:-.7px}.about-copy>p:not(.eyebrow){font-size:14px;line-height:1.75;color:var(--muted)}.about-copy .button{margin-top:12px}
.about-strengths{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px 18px}.strength{display:flex;align-items:flex-start;gap:10px;min-width:0}.strength-icon{display:flex;flex:0 0 36px;width:36px;height:36px;align-items:center;justify-content:center;border-radius:50%;background:#fff2e8;color:var(--red);font-size:20px;font-weight:700}.strength h3{margin:2px 0 6px;color:var(--navy);font-size:14px;line-height:1.3}.strength p{margin:0;color:var(--muted);font-size:11px;line-height:1.55}
/* About image carousel — keeps the original warm red/orange brand styling */
.about-image-wrap{
  height:clamp(250px,25vw,340px);
  overflow:hidden;
  border-radius:5px 48px 5px 5px;
  position:relative;
  isolation:isolate;
  background:#fff5ec;
}
.about-image-slide{
  position:absolute;
  inset:0;
  opacity:0;
  visibility:hidden;
  transition:opacity .55s ease;
}
.about-image-slide.is-active{opacity:1;visibility:visible;z-index:1}
.about-image-slide img{
  display:block;
  width:100%;
  height:100%;
  object-fit:cover;
  clip-path:polygon(7.5% 0,100% 0,100% 100%,0 100%);
}
/* A slim diagonal accent, not a full-size backing panel */
.about-image-slide::before{
  content:"";
  position:absolute;
  inset:0;
  z-index:2;
  pointer-events:none;
  background:linear-gradient(160deg,#f8b15f 0%,var(--orange) 55%,var(--red) 100%);
  clip-path:polygon(5.8% 0,7.5% 0,0 100%,0 100%);
}
.about-image-caption{
  position:absolute;
  z-index:3;
  left:24px;
  bottom:22px;
  padding:9px 13px;
  border-radius:5px;
  color:#fff;
  background:linear-gradient(90deg,rgba(49,31,22,.72),rgba(49,31,22,.18));
  font-size:12px;
  font-weight:750;
  letter-spacing:.4px;
  text-shadow:0 1px 3px #0005;
}
.about-image-controls{
  position:absolute;
  z-index:4;
  right:14px;
  bottom:14px;
  display:flex;
  align-items:center;
  gap:9px;
}
.about-image-controls>button{
  display:grid;
  place-items:center;
  width:30px;
  height:30px;
  padding:0;
  border:1px solid #fff9;
  border-radius:50%;
  color:var(--red);
  background:rgba(255,255,255,.92);
  font-size:22px;
  line-height:1;
  cursor:pointer;
}
.about-image-controls>button:hover{color:#fff;background:var(--orange);border-color:var(--orange)}
.about-image-dots{display:flex;align-items:center;gap:6px}
.about-image-dots button{
  width:7px;
  height:7px;
  padding:0;
  border:1px solid #fff;
  border-radius:50%;
  background:#ffffff80;
  cursor:pointer;
}
.about-image-dots button[aria-current="true"]{background:var(--orange);border-color:#fff;width:18px;border-radius:5px}
.products-home{padding:52px clamp(24px,6vw,92px) 64px;background:#fffaf6}.section-heading{display:flex;align-items:end;justify-content:space-between;margin-bottom:24px}.products-home h2{margin-bottom:8px}.section-intro{margin:0;color:var(--muted);font-size:14px}.product-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.product-card{overflow:hidden;border:1px solid #f0e6dd;border-radius:10px;background:white;transition:transform .2s,box-shadow .2s}.product-card:hover{transform:translateY(-3px);box-shadow:0 12px 28px #6e39140f}.product-image-link{display:block;height:190px;overflow:hidden;background:#f7f4f0}.product-card img{width:100%;height:100%;object-fit:cover;transition:transform .35s}.product-card:hover img{transform:scale(1.035)}.product-card-copy{padding:20px 22px 23px}.product-card h3{margin:0 0 9px;font-size:20px;color:var(--navy)}.product-card p{min-height:48px;margin:0 0 16px;color:var(--muted);font-size:13px;line-height:1.65}.text-link{color:var(--red);font-size:13px;font-weight:750}.text-link:hover{color:var(--orange)}
.home-cta{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:35px clamp(24px,6vw,92px);background:#fff; border-top:1px solid #f1e7df}.home-cta h2{margin-bottom:8px;font-size:clamp(24px,2.4vw,32px)}.home-cta p:not(.eyebrow){margin:0;color:var(--muted);font-size:14px}.home-cta .eyebrow{margin-bottom:8px}
@media(max-width:1100px){.product-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.about-home{grid-template-columns:minmax(280px,.85fr) minmax(0,1.15fr);gap:28px}.about-strengths{grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.about-image-wrap{height:260px}.hero-content{width:72vw}.hero-carousel{height:500px}}
@media(max-width:640px){.hero-carousel{height:540px;min-height:540px}.hero-slide-image{object-position:60% center}.hero-shade,.hero-slide-dark .hero-shade{background:linear-gradient(90deg,rgba(29,22,17,.76),rgba(34,25,19,.42))}.hero-content{width:100%;padding:82px 26px 85px}.hero-content h1{font-size:37px}.hero-description{font-size:15px}.hero-prev{left:12px}.hero-next{right:12px}.hero-arrow{top:auto;bottom:15px;width:38px;height:38px;font-size:27px}.hero-pagination{bottom:29px}.about-home{grid-template-columns:1fr;padding:40px 22px;gap:30px}.about-strengths{grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 14px}.about-image-wrap{height:230px}.products-home{padding:40px 22px}.product-grid{grid-template-columns:1fr;gap:16px}.product-image-link{height:210px}.product-card p{min-height:0}.home-cta{align-items:flex-start;flex-direction:column;padding:32px 22px}}
@media(prefers-reduced-motion:reduce){.hero-slide,.about-image-slide,.product-card,.product-card img{transition:none}}
</style>
