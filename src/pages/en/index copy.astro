---
import SiteLayout from '../../layouts/SiteLayout.astro';
const products = [
  { title: 'Plastic Casings', image: '/images/ht-barrier-matte.jpg', text: 'Smoke-permeable and high-barrier polymer casings, with matte, soft matte and pearlescent options.', href: '/en/plastic-casings/' },
  { title: 'Collagen Casings', image: '/images/collagen-casings-preview.jpg', text: 'Contact us to confirm available collagen casing types, specifications and packaging.', href: '/en/collagen-casings/' },
  { title: 'Cellulose Casings', image: '/images/cellulose-casings-preview.jpg', text: 'Contact us to confirm current cellulose casing availability and supply details.', href: '/en/cellulose-casings/' },
];
const slides = [
  { image: '/images/ht-barrier-matte.jpg', alt: 'Haitu high-barrier matte plastic casing sample', label: 'High-barrier matte casing' },
  { image: '/images/ht-smoke.jpg', alt: 'Haitu smoke-permeable plastic casing sample', label: 'Smoke-permeable casing' },
  { image: '/images/ht-barrier-pearl.jpg', alt: 'Haitu pearlescent high-barrier casing sample', label: 'Pearlescent casing' },
  { image: '/images/ht-standard.jpg', alt: 'Haitu standard high-barrier casing sample', label: 'Standard high-barrier casing' },
];
---
<SiteLayout lang="en" title="Haitu Casing | Plastic Sausage Casings for B2B" description="Explore Haitu plastic sausage casings, including smoke-permeable and high-barrier polymer casing models for meat processors and distributors.">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Sausage casing supply for B2B</p>
      <h1>Plastic Casings for Sausage Manufacturers</h1>
      <p>Smoke-permeable and high-barrier polymer casings for sausage processors and distributors. Compare product applications, surface finishes and available supply forms.</p>
      <div class="hero-buttons"><a class="button button-red" href="/en/plastic-casings/">Explore Plastic Casings <span>→</span></a><a class="button button-outline" href="/en/contact-us/">Request a Quote</a></div>
      <div class="trust-row"><span><b>✓</b> Product-specific information</span><span><b>◎</b> B2B communication</span><span><b>↗</b> Specifications confirmed before order</span></div>
    </div>
    <div class="hero-visual" data-hero-carousel aria-label="Featured Haitu plastic casing products">
      <img class="hero-image" data-hero-image src={slides[0].image} alt={slides[0].alt} fetchpriority="high" />
      <div class="hero-dots" aria-label="Choose featured image">
        {slides.map((slide, index) => <button class="hero-dot" type="button" data-hero-dot data-src={slide.image} data-alt={slide.alt} aria-label={`Show ${slide.label}`} aria-current={index === 0 ? 'true' : 'false'}></button>)}
      </div>
    </div>
  </section>
  <section class="section" id="products">
    <div class="section-heading"><div><p class="eyebrow">Our products</p><h2>Product Categories</h2></div><a class="text-link" href="/en/plastic-casings/">Explore plastic casings →</a></div>
    <div class="product-grid">{products.map((p) => <article class="product-card"><a href={p.href}><img src={p.image} alt={p.title} loading="lazy" /></a><div class="product-card-copy"><h3><a href={p.href}>{p.title}</a></h3><p>{p.text}</p><a class="text-link" href={p.href}>View category →</a></div></article>)}</div>
  </section>
  <section class="section company-summary"><div class="company-summary-copy"><p class="eyebrow">About Haitu Technology</p><h2>Consistent Quality. Practical Solutions.</h2><p>Our supplied product catalog presents a range of polymer casings for meat processing, including smoke-permeable and high-barrier options. We work with B2B customers to confirm application, caliber, printing and supply requirements before quotation.</p><a class="text-link" href="/en/about-us/">Learn about Haitu →</a></div><img src="/images/ht-printed-casing.jpg" alt="Printed polymer sausage casing sample from Haitu's product catalog" loading="lazy" /></section>
  <section class="feature-band"><div class="feature"><span class="feature-icon">◇</span><div><strong>Product Options</strong><p>Smoke-permeable and high-barrier models.</p></div></div><div class="feature"><span class="feature-icon">◎</span><div><strong>Printing</strong><p>Printing options listed for selected models.</p></div></div><div class="feature"><span class="feature-icon">↔</span><div><strong>Supply Forms</strong><p>Rolls or shirred forms, depending on model.</p></div></div><div class="feature"><span class="feature-icon">✉</span><div><strong>Technical Confirmation</strong><p>Confirm order details before production.</p></div></div></section>
  <section class="cta"><div><h2>Looking for the right casing?</h2><p>Share your sausage type, target caliber, printing and packaging requirements.</p></div><a class="button button-red" href="/en/contact-us/">Contact Haitu Casing →</a></section>
</SiteLayout>
<style>
.company-summary {{ padding:48px clamp(22px,6.8vw,104px); display:grid; grid-template-columns:minmax(0,1.2fr) minmax(260px,.8fr); gap:40px; align-items:center; }}
.company-summary h2 {{ color:var(--navy); font-size:clamp(27px,3vw,36px); margin:0 0 14px; }}
.company-summary p:not(.eyebrow) {{ color:var(--muted); line-height:1.75; }}
.company-summary img {{ width:100%; max-height:280px; object-fit:cover; border-radius:14px; }}
@media(max-width:720px) {{ .company-summary {{ grid-template-columns:1fr; gap:20px; padding:38px 20px; }} }}
</style>
