---
const { lang = 'en', title = 'Haitu Casing | Sausage Casing Supplier', description = 'Plastic, collagen and cellulose casings for sausage manufacturers and distributors.' } = Astro.props;
const isRu = lang === 'ru';
const nav = isRu ? [
  { label: 'Главная', href: '/ru/' },
  { label: 'О компании', href: '/ru/o-kompanii/' },
  { label: 'Пластиковые оболочки', href: '/ru/plastikovye-obolochki/' },
  { label: 'Коллагеновые оболочки', href: '/ru/kollagenovye-obolochki/' },
  { label: 'Целлюлозные оболочки', href: '/ru/tsellyuloznye-obolochki/' },
  { label: 'Контакты', href: '/ru/kontakty/' },
] : [
  { label: 'Home', href: '/en/' },
  { label: 'About Us', href: '/en/about-us/' },
  { label: 'Plastic Casings', href: '/en/plastic-casings/' },
  { label: 'Collagen Casings', href: '/en/collagen-casings/' },
  { label: 'Cellulose Casings', href: '/en/cellulose-casings/' },
  { label: 'Contact Us', href: '/en/contact-us/' },
];
const quote = isRu ? 'Запросить цену' : 'Request a Quote';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={isRu ? '/ru/' : '/en/'} aria-label="Haitu Casing home">
        <img class="brand-logo" src="/images/haitu-logo.png" alt="Haitu Technology logo" />
        <span class="brand-copy"><strong>HAITU <em>CASING</em></strong><small>by Haitu Technology</small></span>
      </a>
      <nav aria-label={isRu ? 'Основная навигация' : 'Main navigation'}>
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <div class="header-actions">
        <a class="language" href={isRu ? '/en/' : '/ru/'}>{isRu ? 'EN' : 'RU'}</a>
        <a class="button button-red button-small" href={isRu ? '/ru/kontakty/' : '/en/contact-us/'}>{quote}</a>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="footer-brand"><strong>HAITU CASING</strong><span>A product brand of Haitu Technology</span></div>
      <p>{isRu ? 'Поставщик оболочек для производителей колбасных изделий и дистрибьюторов.' : 'Sausage casing supply for manufacturers and distributors.'}</p>
      <div class="footer-links"><a href={isRu ? '/ru/kontakty/' : '/en/contact-us/'}>{isRu ? 'Связаться с нами' : 'Contact Us'}</a><a href={isRu ? '/en/' : '/ru/'}>{isRu ? 'English' : 'Русский'}</a></div>
      <small>© {new Date().getFullYear()} Haitu Technology. All rights reserved.</small>
    </footer>
  </body>
</html>
<script>
  const carousel = document.querySelector('[data-hero-carousel]');
  if (carousel) {
    const image = carousel.querySelector('[data-hero-image]');
    const dots = Array.from(carousel.querySelectorAll('[data-hero-dot]'));
    const slides = dots.map((dot) => ({ src: dot.getAttribute('data-src') || '', alt: dot.getAttribute('data-alt') || '' }));
    let active = 0;
    let timer;
    const show = (index) => {
      active = index;
      image.style.opacity = '0.35';
      window.setTimeout(() => {
        image.src = slides[active].src;
        image.alt = slides[active].alt;
        image.onload = () => { image.style.opacity = '1'; };
        if (image.complete) image.style.opacity = '1';
      }, 120);
      dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === active)));
    };
    const start = () => { window.clearInterval(timer); timer = window.setInterval(() => show((active + 1) % slides.length), 5000); };
    dots.forEach((dot, i) => dot.addEventListener('click', () => { show(i); start(); }));
    if (slides.length > 1) start();
  }
</script>
<style is:global>
  :root{font-family:Inter,Arial,Helvetica,sans-serif;color:#263746;background:#fff;font-synthesis:none;text-rendering:optimizeLegibility;--red:#c93636;--orange:#f28a35;--navy:#183a59;--muted:#647586;--line:#e8edf0}
  *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0}a{color:inherit;text-decoration:none}.site-header{min-height:82px;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:16px clamp(20px,5vw,76px);border-bottom:1px solid #f0f1f2;background:#fff}.brand{display:flex;align-items:center;gap:10px;flex-shrink:0}.brand-logo{width:190px;height:auto;max-height:64px;object-fit:contain;object-position:left center;display:block}.brand-copy{display:flex;flex-direction:column;gap:2px}.brand-copy strong{font-size:21px;letter-spacing:.4px;color:var(--navy)}.brand-copy em{font-style:normal;color:var(--orange)}.brand-copy small{font-size:11px;color:var(--muted)}nav{display:flex;align-items:center;justify-content:center;gap:clamp(10px,1.6vw,24px)}nav a{font-size:12px;font-weight:650;white-space:nowrap}nav a:hover,.footer-links a:hover{color:var(--red)}.header-actions{display:flex;align-items:center;gap:14px;flex-shrink:0}.language{font-size:12px;font-weight:700;color:var(--navy)}.button{display:inline-flex;justify-content:center;align-items:center;gap:8px;border-radius:999px;padding:13px 21px;font-size:13px;font-weight:700;transition:transform .15s ease,background .15s ease}.button:hover{transform:translateY(-1px)}.button-red{background:var(--red);color:white}.button-red:hover{background:#ad2929}.button-outline{border:1px solid var(--red);color:var(--red);background:white}.button-small{padding:10px 17px;font-size:12px}.hero{display:grid;grid-template-columns: .9fr 1.1fr;align-items:center;min-height:490px;padding:45px clamp(22px,6.8vw,104px);gap:24px;background:linear-gradient(105deg,#fff 0%,#fff 42%,#fff9f4 100%);overflow:hidden}.eyebrow{margin:0 0 14px;color:var(--red);font-size:12px;font-weight:800;letter-spacing:1px;text-transform:uppercase}.hero h1{max-width:600px;margin:0 0 18px;font-size:clamp(34px,4vw,55px);line-height:1.07;letter-spacing:-1.8px;color:var(--navy)}.hero-copy>p:not(.eyebrow){max-width:510px;color:var(--muted);font-size:17px;line-height:1.65;margin:0 0 24px}.hero-buttons{display:flex;flex-wrap:wrap;gap:12px}.hero-visual{position:relative;min-width:0}.hero-image{display:block;width:100%;height:390px;object-fit:cover;border-radius:20px;mix-blend-mode:multiply;transition:opacity .25s ease}.hero-dots{display:flex;justify-content:center;gap:8px;margin-top:12px}.hero-dot{width:9px;height:9px;border:0;border-radius:50%;padding:0;background:#d9dfe4;cursor:pointer}.hero-dot[aria-current="true"]{background:var(--red);transform:scale(1.12)}.catalog-intro{max-width:850px;color:var(--muted);line-height:1.7}.series-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin:12px 0 22px}.series-heading h2{margin:0;color:var(--navy);font-size:clamp(24px,3vw,32px)}.series-heading p{max-width:660px;color:var(--muted);line-height:1.6;margin:8px 0 0}.catalog-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.catalog-card{border:1px solid var(--line);border-radius:12px;overflow:hidden;background:#fff}.catalog-card img{width:100%;height:190px;display:block;object-fit:cover;background:#f8f8f8}.catalog-card-copy{padding:18px}.catalog-card h3{color:var(--navy);margin:0 0 8px;font-size:18px}.catalog-card p{color:var(--muted);font-size:13px;line-height:1.6;margin:0}.catalog-card .text-link{display:inline-block;margin-top:14px}.series-block{padding:36px 0;border-bottom:1px solid var(--line)}.series-block:last-child{border-bottom:0}.trust-row{display:flex;flex-wrap:wrap;gap:16px;margin-top:28px;color:var(--muted);font-size:11px;line-height:1.45}.trust-row span{display:flex;align-items:center;gap:7px}.trust-row b{color:var(--navy);font-size:17px}.section{padding:62px clamp(22px,6.8vw,104px)}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:24px}.section-heading .eyebrow{margin-bottom:7px}.section h2{margin:0;color:var(--navy);font-size:clamp(27px,3vw,36px);letter-spacing:-.8px}.text-link{color:var(--red);font-size:13px;font-weight:700}.product-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.product-card{border:1px solid var(--line);border-radius:12px;overflow:hidden;background:#fff;transition:box-shadow .2s,transform .2s}.product-card:hover{transform:translateY(-3px);box-shadow:0 12px 28px #203a4c12}.product-card img{display:block;width:100%;height:205px;object-fit:cover;background:#f7f8f9}.product-card-copy{padding:18px 18px 20px}.product-card h3{margin:0 0 8px;color:var(--navy);font-size:19px}.product-card p{margin:0;color:var(--muted);font-size:13px;line-height:1.6}.product-card .text-link{display:inline-block;margin-top:14px}.feature-band{background:#f8f9fa;display:grid;grid-template-columns:repeat(4,1fr);gap:20px;padding:30px clamp(22px,6.8vw,104px)}.feature{display:flex;align-items:flex-start;gap:12px}.feature-icon{font-size:24px;color:var(--red)}.feature strong{display:block;color:var(--navy);font-size:13px;margin-bottom:5px}.feature p{margin:0;color:var(--muted);font-size:12px;line-height:1.5}.cta{margin:46px clamp(22px,6.8vw,104px);padding:34px 38px;border-radius:16px;background:var(--navy);display:flex;align-items:center;justify-content:space-between;gap:24px;color:#fff}.cta h2{font-size:clamp(23px,3vw,32px);margin:0 0 8px}.cta p{color:#d7e0e8;margin:0;line-height:1.5}.cta .button{flex-shrink:0}.page-intro{background:#fff8f3;padding:60px clamp(22px,6.8vw,104px)}.page-intro h1{font-size:clamp(32px,4vw,48px);color:var(--navy);margin:0 0 14px}.page-intro p{max-width:760px;color:var(--muted);line-height:1.7;font-size:16px}.content-section{padding:45px clamp(22px,6.8vw,104px);max-width:1200px}.content-section h2{color:var(--navy)}.spec-note{border-left:4px solid var(--orange);background:#fff8f3;padding:16px 18px;color:#596a77;line-height:1.6}.site-footer{padding:35px clamp(22px,6.8vw,104px) 22px;background:#f7f8f9;color:var(--muted);font-size:12px}.footer-brand{display:flex;flex-direction:column;gap:4px}.footer-brand strong{font-size:18px;color:var(--navy)}.footer-links{display:flex;gap:20px;margin:16px 0}.site-footer>small{display:block;border-top:1px solid var(--line);padding-top:16px}.contact-card{border:1px solid var(--line);border-radius:12px;padding:24px;max-width:700px}.contact-card p{line-height:1.7;color:var(--muted)}
  @media(max-width:1100px){.site-header{flex-wrap:wrap}.site-header nav{order:3;width:100%;justify-content:flex-start;overflow-x:auto;padding:8px 0 3px}.hero{grid-template-columns:1fr 1fr}.hero-image{max-height:320px}.product-card img{height:170px}}
  @media(max-width:720px){.site-header{padding:14px 18px;gap:12px}.brand-copy strong{font-size:18px}.brand-logo{width:150px;height:auto;max-height:52px}.header-actions{margin-left:auto}.header-actions .button{display:none}.site-header nav{gap:18px}nav a{font-size:12px}.hero{grid-template-columns:1fr;padding:38px 20px 26px;gap:24px}.hero h1{font-size:39px;letter-spacing:-1px}.hero-copy>p:not(.eyebrow){font-size:15px}.hero-image{height:260px;max-height:280px}.catalog-grid{grid-template-columns:1fr}.catalog-card img{height:220px}.section{padding:42px 20px}.section-heading{align-items:flex-start}.product-grid{grid-template-columns:1fr;gap:16px}.product-card img{height:220px}.feature-band{grid-template-columns:1fr 1fr;padding:24px 20px;gap:24px 14px}.cta{margin:26px 20px;padding:26px 22px;align-items:flex-start;flex-direction:column}.page-intro{padding:40px 20px}.content-section{padding:32px 20px}.site-footer{padding:28px 20px 18px}}
</style>
